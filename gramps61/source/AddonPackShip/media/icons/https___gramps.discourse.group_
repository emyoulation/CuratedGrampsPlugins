;value\\\&quot;:\\\&quot;pt\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.pt.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;Português (BR)\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;pt_BR\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.pt_BR.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;limba română\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;ro\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.ro.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;Русский\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;ru\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.ru.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;slovenčina\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;sk\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.sk.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;slovenščina\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;sl\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.sl.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;Shqip\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;sq\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.sq.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;српски језик\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;sr\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.sr.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;svenska\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;sv\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.sv.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;Kiswahili\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;sw\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.sw.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;తెలుగు\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;te\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.te.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;ไทย\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;th\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.th.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;Türkçe\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;tr_TR\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.tr_TR.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;ئۇيغۇرچە\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;ug\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.ug.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;українська мова\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;uk\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.uk.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;اردو\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;ur\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.ur.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;tiếng Việt\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;vi\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.vi.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;简体中文\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;zh_CN\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.zh_CN.name\\\&quot;},{\\\&quot;native_name\\\&quot;:\\\&quot;繁體中文\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;zh_TW\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;languages.zh_TW.name\\\&quot;}]\&quot;,\&quot;available_content_localization_locales\&quot;:[{\&quot;native_name\&quot;:\&quot;English\&quot;,\&quot;value\&quot;:\&quot;en\&quot;,\&quot;name\&quot;:\&quot;languages.en.name\&quot;}],\&quot;require_invite_code\&quot;:false,\&quot;site_logo_url\&quot;:\&quot;https://global.discourse-cdn.com/free1/uploads/gramps/original/1X/ebad9b29f86755c52ac3e10a9fecd54c5d47da27.png\&quot;,\&quot;site_logo_small_url\&quot;:\&quot;https://global.discourse-cdn.com/free1/uploads/gramps/original/1X/2ac1e712b7adf612e31ca08a55419f4cf37c0158.png\&quot;,\&quot;site_mobile_logo_url\&quot;:\&quot;https://global.discourse-cdn.com/free1/uploads/gramps/original/1X/ebad9b29f86755c52ac3e10a9fecd54c5d47da27.png\&quot;,\&quot;site_favicon_url\&quot;:\&quot;https://global.discourse-cdn.com/free1/uploads/gramps/optimized/1X/2ac1e712b7adf612e31ca08a55419f4cf37c0158_2_32x32.png\&quot;,\&quot;site_logo_dark_url\&quot;:\&quot;\&quot;,\&quot;site_logo_small_dark_url\&quot;:\&quot;\&quot;,\&quot;site_mobile_logo_dark_url\&quot;:\&quot;\&quot;}&quot;,&quot;themeSiteSettingOverrides&quot;:&quot;{\&quot;enable_welcome_banner\&quot;:false,\&quot;search_experience\&quot;:\&quot;search_icon\&quot;}&quot;,&quot;customHTML&quot;:&quot;{\&quot;top\&quot;:\&quot;\&quot;,\&quot;footer\&quot;:\&quot;\&quot;}&quot;,&quot;banner&quot;:&quot;{\&quot;html\&quot;:\&quot;\u003cp\u003eGramps is a free software project and community. We strive to produce a genealogy program that is both intuitive for hobbyists and feature-complete for professional genealogists. It is a community project, created, developed and governed by genealogists.\\u003C/p\u003e\\n\u003cp\u003eWelcome, this forum is intended to be used by both users and developers of Gramps.\\u003C/p\u003e\\n\u003cp\u003eFor further information, please visit our \u003ca href=\\\&quot;https://gramps-project.org\\\&quot;\u003ewebsite\\u003C/a\u003e or read the \u003ca href=\\\&quot;https://gramps-project.org/wiki/index.php\\\&quot;\u003edocumentation\\u003C/a\u003e on our wiki. \u003cem\u003eWatching some of the \u003ca href=\\\&quot;https://gramps.discourse.group/t/tutorial-videos/126\\\&quot;\u003etutorial videos\\u003C/a\u003e will greatly simplify \u003cstrong\u003egetting started with Gramps\\u003C/strong\u003e.\\u003C/em\u003e\\u003C/p\u003e\\n\u003cp\u003e\u003cimg src=\\\&quot;https://global.discourse-cdn.com/free1/uploads/gramps/original/2X/b/b2e96766ac36ce5101d8fba528c3c1b63a9b935e.png\\\&quot; alt=\\\&quot;DownloadUG\\\&quot; data-base62-sha1=\\\&quot;pwJ3qCkpn1JtAQ1D3OXMSZMyZHM\\\&quot; width=\\\&quot;20\\\&quot; height=\\\&quot;100\\\&quot;\u003e \u0026nbsp; \u003ca href=\\\&quot;https://gramps-project.org/wiki/index.php/User_manual_translations#pdfs\\\&quot;\u003e\u003cimg src=\\\&quot;https://global.discourse-cdn.com/free1/uploads/gramps/original/2X/2/26a4c95d42138a92dc5bc7c48f16721e26c1bc3a.png\\\&quot; alt=\\\&quot;GrampsPDF\\\&quot; data-base62-sha1=\\\&quot;5vRcfayjKlr554YYwjV1zFsD426\\\&quot; width=\\\&quot;78\\\&quot; height=\\\&quot;100\\\&quot;\u003e\\u003C/a\u003e \u0026nbsp;  \u003ca href=\\\&quot;https://gramps-project.org/wiki/index.php/File:GrampsAddonsUserManual.pdf\\\&quot;\u003e\u003cimg src=\\\&quot;https://global.discourse-cdn.com/free1/uploads/gramps/original/2X/2/2cb28a27163805ca3f9e16470bf820120a8712b1.png\\\&quot; alt=\\\&quot;image\\\&quot; data-base62-sha1=\\\&quot;6npwKe5bOyhhSpvvJkNzVzRL6yB\\\&quot; width=\\\&quot;77\\\&quot; height=\\\&quot;100\\\&quot;\u003e\\u003C/a\u003e\\u003C/p\u003e\\n\u003cp\u003eBugs can be reported on our \u003ca href=\\\&quot;https://gramps-project.org/wiki/index.php/Using_the_bug_tracker\\\&quot;\u003ebug tracker\\u003C/a\u003e.\\u003C/p\u003e\\n\u003cp\u003eUsers who prefer mailing lists should read the \u003ca href=\\\&quot;https://gramps.discourse.group/t/discourse-email-settings/116\\\&quot;\u003eDiscourse email settings\\u003C/a\u003e post and enable mailing list mode. \u003ca href=\\\&quot;https://gramps.discourse.group/t/discourse-new-user-guide/707\\\&quot;\u003eLearn more in the \u003cem\u003e\u003cstrong\u003eDiscourse New User Guide\\u003C/strong\u003e\\u003C/em\u003e\\u003C/a\u003e.\\u003C/p\u003e\&quot;,\&quot;key\&quot;:7,\&quot;url\&quot;:\&quot;https://gramps.discourse.group/t/welcome-to-the-gramps-discourse-forum/7\&quot;}&quot;,&quot;customEmoji&quot;:&quot;[]&quot;,&quot;isReadOnly&quot;:&quot;false&quot;,&quot;isStaffWritesOnly&quot;:&quot;false&quot;,&quot;activatedThemes&quot;:&quot;{\&quot;2\&quot;:{\&quot;name\&quot;:\&quot;Light\&quot;,\&quot;settings\&quot;:{}},\&quot;3\&quot;:{\&quot;name\&quot;:\&quot;Keyboard Text Button Component\&quot;,\&quot;settings\&quot;:{\&quot;svg_icons\&quot;:\&quot;keyboard\&quot;}}}&quot;,&quot;upcomingChanges&quot;:&quot;{\&quot;ai_bot_enable_docked_composer\&quot;:true,\&quot;chat_pinned_messages\&quot;:false,\&quot;composer_media_optimization_image_convert_enabled\&quot;:false,\&quot;dashboard_improvements\&quot;