msgid ""
"Off (default): listings are English-only, regardless of how many languages "
"an addon has translations for.\n"
"On: every {listing} that already exists is updated with the selected addon "
"(translated where a translation exists, English otherwise). A new {listing} "
"is created only when the name or description in the {gpr} of the addon is "
"actually translated into that language."
msgstr ""

#: AddonPackShip.py:2353
msgid "Duplicate into unverified/incompatible versions anyway"
msgstr ""

#: AddonPackShip.py:2356
#, python-brace-format
msgid ""
"Off (default): a multi-version build skips duplicating the package into any "
"Gramps version that the {gpr} of the addon does not demonstrably support (an "
"explicit version-range gate that excludes it, or a hardcoded {target} naming "
"a different one).\n"
"On: duplicates into every checked version regardless. Nothing about the "
"{gpr} itself is ever changed either way -- this only controls whether a "
"mismatched version still gets a copy."
msgstr ""

