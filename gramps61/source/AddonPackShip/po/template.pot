msgid "Duplicate into unverified/incompatible versions anyway"
msgstr ""

#: AddonPackShip.py:2474
#, python-brace-format
msgid ""
"Off (default): an addon with an adaptive {gpr} (one with a version check) is "
"not packed or listed for a checked Gramps version that its version check "
"rejects.\n"
"On: it is packed and listed for every checked version regardless.\n"
"Addons whose {gpr} is not adaptive (no version check, or a hardcoded "
"{target}) are never packed for several versions silently: Pack and Ship "
"warns and asks first. Nothing about the {gpr} itself is ever changed."
msgstr ""

