def _get_fuzzy_match_lookup():
    """
    Look up and import the Fuzzy Matching addon's "Fuzzy Match API"
    GENERAL plugin via Gramps' own plugin registry, returning its
    show_fuzzy_lookup function -- see _handle_pipe_icon_double_click()
    and, in the Fuzzy Matching addon's own folder, FuzzyMatchAPI.md
    for the calling convention it follows.

    Deliberately not a bare `import FuzzyMatchLookupWindow`: an
    earlier version of this did exactly that, both at this module's
    own top level and, when that turned out to fail silently even
    with Fuzzy Matching installed and working, again at click time
    instead -- neither worked. Gramps only adds an addon's own folder
    to sys.path *while it is itself importing that addon's registered
    module*, then resets it again immediately after (see
    BasePluginManager.import_plugin()'s own docstring: "this will add
    the pdata.fpath to sys.path first (if needed), import, and then
    reset path") -- it does not leave every addon's folder on
    sys.path for the rest of the session the way an earlier version
    of this comment assumed. A bare import from a *different* addon's
    code has no such guarantee at any point after Fuzzy Matching's own
    module has finished its own one-time load. Going through
    BasePluginManager's own get_plugin()/import_plugin() is what
    actually sets sys.path correctly for this one import, which is
    exactly what registering "Fuzzy Match API" as a GENERAL plugin
    (see FuzzyMatchingGramplet.gpr.py, in that addon's own folder) is
    for -- see the Gramps wiki's "Addons development" page, "General
    plugins" section, for the standard pattern this follows.

    :returns: The show_fuzzy_lookup function, or None if the Fuzzy
        Matching addon isn't installed/enabled, isn't new enough to
        register this plugin, or the import otherwise fails.
    """
    pmgr = BasePluginManager.get_instance()
    pdata = pmgr.get_plugin("Fuzzy Match API")
    if pdata is None:
        return None
    try:
        module = pmgr.import_plugin(pdata)
    except ImportError:
        return None
    if module is None:
        return None
    return getattr(module, "show_fuzzy_lookup", None)

# -------------------------------------------------------------------------
#
# configuration
#
# -------------------------------------------------------------------------

# This addon's own registered id (see PhotoTaggingGramplet.gpr.py), used
# both to look up its own PluginData (README path, help_url) when the
# Help button is clicked, and below as an identity check saved into
# PhotoTaggingGramplet.ini's own [meta] section.
MY_PLUGIN_ID = "Photo Tagging"

# Bumped whenever a change to the saved keys below would make an older
# PhotoTaggingGramplet.ini misleading rather than merely out of date
# (e.g. a renamed or repurposed key) -- see _CONFIG's own identity/schema
# check just below. Adding a brand new key with a sensible default (as
# opposed to renaming or repurposing an existing one) does not need a
# bump -- an older .ini simply won't have it, and it loads as that default.
_CONFIG_SCHEMA_VERSION = "1"

GRAMPLET_CONFIG_NAME = "phototagginggramplet"

# Registering with this module's own directory plus GRAMPLET_CONFIG_NAME
# (no ".ini" suffix -- Gramps adds that) places the resulting
# PhotoTaggingGramplet.ini alongside PhotoTaggingGramplet.py, matching
# RelationshipFilter.ini's own placement next to RelationshipFilter.py,
# rather than register_manager()'s own default location.
_PLUGIN_DIR = os.path.dirname(os.path.abspath(__file__))
CONFIG = config.register_manager(os.path.join(_PLUGIN_DIR, GRAMPLET_CONFIG_NAME))
CONFIG.register("meta.plugin_id", "")
CONFIG.register("meta.schema_version", "")
CONFIG.register("detection.box_size", (50, 50))
CONFIG.register("detection.inside_existing_boxes", False)
CONFIG.register("detection.sensitivity", 10)
CONFIG.register("selection.replace_without_asking", False)
# 0 (Name.DEF) means "no override" -- the Name column and the Caption
# generator fall back to each Name's own "Display as" field, and from
# there to whichever format Preferences > Data > Name format currently
# selects, exactly as they did before this setting existed. Any other
# value is one of name_displayer.get_name_format()'s own format ids,
# taking priority over both of those -- see
# display_name_respecting_format()'s own docstring.
CONFIG.register("selection.name_display_format", 0)
# The format string that "selection.name_display_format" pointed to the
# last time it was saved (see save_config()). A custom name format's
# own id is just its position in Preferences > Data > Name format's own
# list -- editing, reordering, or deleting *any* custom format there
# can silently repoint an unrelated id at a different format, or at
# nothing at all. Saving the string alongside the id, and treating a
# mismatch between them as "the id no longer means what it used to",
# is how validate_name_display_format_override() below catches that
# rather than silently mis-rendering names under a format the person
# never actually chose. Empty string is a valid value (matches
# Name.DEF's own permanent empty format_str, and also naturally covers
# a pre-upgrade config saved before this key existed).
CONFIG.register("selection.name_display_format_str", "")
# Empty string means "use the Caption panel's own default font" (see
# CaptionTextEditor.__init__()/cb_choose_font()); otherwise a
# Pango.FontDescription string, e.g. "Sans 10" or "Serif Bold 12".
CONFIG.register("caption.font", "")
CONFIG.load()

if (
    CONFIG.get("meta.plugin_id") != MY_PLUGIN_ID
    or CONFIG.get("meta.schema_version") != _CONFIG_SCHEMA_VERSION
):
    # Missing (a fresh install, nothing ever saved here yet) or from an
    # incompatible revision of this addon -- reset every saved setting to
    # its default rather than risk misinterpreting a value some future
    # (or, in principle, past) revision of this code saved with a
    # different meaning. This is also what writes PhotoTaggingGramplet.ini
    # for the very first time, with correct [meta] values, on a fresh
    # install -- see RelationshipFilter.ini's own identical pattern for
    # why both are registered with a default (an empty string) that can
    # never match a real saved value.
    LOG.info(
        "Photo Tagging settings are missing or from an incompatible "
        "version; resetting to defaults."
    )
    CONFIG.reset()
    CONFIG.set("meta.plugin_id", MY_PLUGIN_ID)
    CONFIG.set("meta.schema_version", _CONFIG_SCHEMA_VERSION)
    CONFIG.save()

MIN_FACE_SIZE = CONFIG.get("detection.box_size")
REPLACE_WITHOUT_ASKING = CONFIG.get("selection.replace_without_asking")
DETECT_INSIDE_EXISTING_BOXES = CONFIG.get("detection.inside_existing_boxes")
SENSITIVITY = CONFIG.get("detection.sensitivity")


def validate_name_display_format_override(number, expected_fmt_str):
    """
    Return `number` if it still means what it meant when saved,
    otherwise ``Name.DEF`` (0, "no override").

    A custom name format's own id in Gramps is just its position in
    Preferences > Data > Name format's own list -- there's nothing
    else identifying it. Adding, editing, reordering, or deleting any
    custom format there (not necessarily the one this addon is
    pointed at) can silently repoint a previously-valid id at a
    completely different format, or at nothing at all, with no error
    raised anywhere -- the Name column and Caption generator would
    just start rendering names under a format the person never chose,
    indistinguishable from correct output until someone happens to
    notice.

    Cross-checking the id against the format string saved alongside it
    (see ``selection.name_display_format_str``'s own CONFIG.register()
    comment) catches this: if Gramps' *current* list has no entry for
    `number`, or that entry's format string no longer matches
    `expected_fmt_str`, the id has been repointed since it was saved,
    and falling back to Name.DEF is the safe choice -- silently
    reverting to "use Gramps' regular preference" is far less harmful
    than silently rendering names under the wrong format indefinitely.

    ``Name.DEF`` itself is always considered valid regardless of
    `expected_fmt_str`: its own format_str is a permanent empty
    placeholder (see ``display_name_respecting_format()``'s docstring),
    not a real format that could ever go stale.

    :param number: A stored ``selection.name_display_format`` value.
    :param expected_fmt_str: The ``selection.name_display_format_str``
        saved alongside it.
    :returns: `number`, unchanged, if still valid; otherwise
        ``Name.DEF``.
    """
    if number == Name.DEF:
        return Name.DEF
    current_fmt_str = None
    for fmt_number, _label, fmt_str, _active in name_displayer.get_name_format(
        also_default=True
    ):
        if fmt_number == number:
            current_fmt_str = fmt_str
            break
    if current_fmt_str is None or current_fmt_str != expected_fmt_str:
        LOG.info(
            "Photo Tagging: saved name display format id %s no longer "
            "matches its saved format string (Preferences > Data > Name "
            "format has changed since); reverting to Default format.",
            number,
        )
        return Name.DEF
    return number


NAME_DISPLAY_FORMAT_OVERRIDE = validate_name_display_format_override(
    CONFIG.get("selection.name_display_format"),
    CONFIG.get("selection.name_display_format_str"),
)

