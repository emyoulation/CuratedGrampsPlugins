#: vcardenhanced.gpr.py:95 vcardenhanced.gpr.py:118
msgid "vCard (Enhanced — v1/2.1/3.0/4.0)"
msgstr ""

#: vcardenhanced.gpr.py:97
msgid ""
"Import contacts from vCard files (.vcf). Supports vCard versions 1, 2.1, "
"3.0, and 4.0. Embedded photos become Media objects, relationships become "
"Associations, and unhandled properties are preserved as Person attributes. "
"Variant Call Format (DNA) files are detected and rejected."
msgstr ""

#: vcardenhanced.gpr.py:119
msgid "_vCard (Enhanced)"
msgstr ""

#: vcardenhanced.gpr.py:121
msgid ""
"Export contacts to vCard files (.vcf). Supports vCard versions 1, 2.1, 3.0, "
"and 4.0 (default: 3.0). Round-trips files made by the Enhanced vCard "
"importer."
msgstr ""

