#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Çfarë vjen më pas"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplet që sugjeron gjëra për t'u kërkuar"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Çfarë vjen më pas?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Ndihmë"

#: WhatsNext.py:206
msgid "People"
msgstr "Njerëzit"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Emër i panjohur"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Raporto një person pa emër"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Mbiemër i panjohur"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Raporto një person pa mbiemër"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Mungon ngjarja Lindja"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Raporto një person pa ngjarjen Lindja"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Data dhe vendi i lindjes"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Kontrollo datën dhe vendin e ngjarjes Lindja"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Mungon ngjarja Vdekja"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Raporto një person pa ngjarjen Vdekja, kur Gramps gjykon nga datat e "
"personit dhe të të afërmve se personi nuk jeton më"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Data dhe vendi i vdekjes"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Kontrollo datën dhe vendin e ngjarjes Vdekja"

#: WhatsNext.py:241
msgid "Families"
msgstr "Familjet"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Lloj marrëdhënieje i panjohur"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Raporto një familje me llojin e marrëdhënies \"E panjohur\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Mungon ngjarja Martesa"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Raporto një familje të llojit \"I martuar\" pa ngjarjen Martesa"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Data dhe vendi i martesës"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Kontrollo datën dhe vendin e ngjarjes Martesa"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Data dhe vendi i ndarjes"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Kontrollo datën dhe vendin e ngjarjes Ndarje"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Mardhëniet"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Mungon familja e prindërve"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Rendit çdo person që nuk ka familje prindërish"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Mungon partneri"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Raporto një familje me vetëm një partner"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Mungon babai"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Raporto një person, familja e prindërve të të cilit nuk ka baba"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Mungon nëna"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Raporto një person, familja e prindërve të të cilit nuk ka nënë"

#: WhatsNext.py:291
msgid "Events"
msgstr "Ngjarjet"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Datë e panjohur"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Raporto një ngjarje pa datë"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Data është vetëm tekst"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Raporto një datë që Gramps nuk mundi ta lexonte si datë"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Datë e pasaktë"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Raporto një interval, një periudhë ose një datë me \"para\", \"pas\", "
"\"rreth\", \"e vlerësuar\" ose \"e llogaritur\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Datë e paplotë"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Raporto një datë të vetme pa ditë ose muaj"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Vend i panjohur"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Raporto një ngjarje pa vend"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Shkruani emrin që mungon në dritaren Redakto personin."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Shtojeni përmes skedës Ngjarjet të dritares Redakto personin."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Hapni ngjarjen në skedën Ngjarjet të dritares Redakto personin dhe plotësoni"
" datën dhe vendin e saj."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Hapni ngjarjen në skedën Ngjarjet të dritares Redakto familje dhe plotësoni "
"datën dhe vendin e saj."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Shtoni një ngjarje Martesa në skedën Ngjarjet të dritares Redakto familje."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Zgjidhni \"Tipin\" e marrëdhënies në dritaren Redakto familje."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Shtoni partnerin që mungon në dritaren Redakto familje."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Shtoni babain në dritaren Redakto familje të familjes së prindërve."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Shtoni nënën në dritaren Redakto familje të familjes së prindërve."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"Në pamjen Marrëdhëniet, zgjidhni \"Shto prindër të rinj...\" ose \"Shto "
"prindër që ekzistojnë...\" nga menyja Redakto."

#: WhatsNext.py:400
msgid "Completed"
msgstr "E përfunduar"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "E shpërfillur"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "E krasitur"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Ende nuk është ngarkuar asnjë bazë të dhënash lokale e pemës gjenealogjike.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Hapat e ardhshëm:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  Nga menyja \"Pemët Familjare\","

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " përdorni opsionin \"Menaxho Pemët Familjare...\" për të"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr ""
" krijuar një bazë të dhënash të re të pemës (ose për të zgjedhur një "
"ekzistuese).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Klikoni butonin \"Ngarko Pemë Familjare\" për të filluar"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" punën me pemën gjenealogjike të zgjedhur.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Për të përdorur një kopje rezervë nga Gramps, ose një skedar GEDCOM nga një mjet tjetër gjenealogjik, zgjidhni \"Importo...\" në menynë \"Pemët Familjare\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Për të përdorur një kopje rezervë nga Gramps, ose një skedar GEDCOM nga një mjet tjetër gjenealogjik, fillimisht krijoni dhe ngarkoni një pemë të re bosh. Pastaj zgjidhni \"Importo...\" në menynë \"Pemët Familjare\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Përdorni \"Konfiguro\" në menynë \"Pamje\" për të ndryshuar opsionet e "
"Gramplet-it."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Organizo etiketat"

#: WhatsNext.py:719
msgid "Complete"
msgstr "E përfunduar"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Etiketo personat dhe familjet e renditura si të Përfunduara"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Shpërfill"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Etiketo për të shpërfillur persona dhe familje"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Krasit"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Etiketo për të krasitur (përjashtuar) nga kontrolli personat dhe familjet e "
"renditura"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Kuota e kërkimit "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Numri më i vogël i rreshtave për t'u shfaqur. Kërkimi ndalet sapo gjenden "
"kaq probleme"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Thellësia për cikël"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Sa breza pasardhësish të kontrollohen para se të ngjitet edhe një brez "
"paraardhësish"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Ndalo përkohësisht zgjerimin e kërkimit"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Sa raunde shtesë të pritet pas kontrollit të një paraardhësi para se të "
"kontrollohen pasardhësit e tij"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Etiketa E përfunduar"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Përfundoi. Fshih objektin dhe vazhdo kërkimin përmes tij"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Etiketa E shpërfillur"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "Lënë mënjanë për tani. Fshih objektin dhe vazhdo kërkimin përmes tij"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Etiketa E krasitur"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Rrugë pa krye. Fshih objektin dhe ndalo kërkimin përmes tij"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Shfaq 👣 hapat e ardhshëm të sugjeruar"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Shfaq hapat udhëzues dhe 👣 sugjerimet. Çaktivizojeni për një listë më të "
"shkurtër"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Rishiko (hap redaktuesin)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Etiketo si E përfunduar"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Etiketo për shpërfillje"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Etiketo për krasitje"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Etiketo si %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Baza e të dhënave e pemës aktuale nuk përmban persona.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Hapat e ardhshëm:\n"
" Shtoni një familje dhe një person në atë familje:\n"
"  • Një familje mund të shtohet përmes menysë \"Shto\"\n"
"  • Një person mund të shtohet duke shtypur \"+\" (plus) në panelet e bashkëshortëve (\"Babai/partneri1\" ose \"Nëna/partneri2\") ose në skedën \"Fëmijë\".\n"
"\n"
"Ose importoni persona nga një skedar i jashtëm:\n"
"  • Një skedar i jashtëm mund të përdoret për të mbushur pemën përmes \"Importo...\" në menynë \"Pemët Familjare\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Asnjë person nuk është zgjedhur si \"Person i parazgjedhur\" qendror.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Hapat e ardhshëm:\n"
"  •  Zgjidhni ikonën e pamjes Personat në shiritin anësor të Navigatorit.\n"
"  •  Zgjidhni dikë për ta bërë \"Personi aktiv\".\n"
"  •  Zgjidhni \"Vendos Person Shtëpiak\" nga menyja Redakto ose nga menyja e kontekstit (klikim i djathtë).\n"
"\n"
" Kështu ai bëhet \"Person i parazgjedhur\" qendror."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Klikoni dy herë tekstin me ngjyrë për të redaktuar hollësitë"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "Person i parazgjedhur qendror"

