#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Kas toliau"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Grampleto pasiūlytų dalykų tyrimas"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Kas toliau?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Žinynas"

#: WhatsNext.py:206
msgid "People"
msgstr "Asmenys"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Nežinomas vardas"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Pranešti apie asmenį be vardo"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Nežinoma pavardė"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Pranešti apie asmenį be pavardės"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Trūksta Gimimo įvykio"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Pranešti apie asmenį be Gimimo įvykio"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Gimimo data ir vieta"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Patikrinti Gimimo įvykio datą ir vietą"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Trūksta Mirties įvykio"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Pranešti apie asmenį be Mirties įvykio, kai Gramps pagal asmens ir giminių "
"datas sprendžia, kad asmuo jau nebegyvas"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Mirties data ir vieta"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Patikrinti Mirties įvykio datą ir vietą"

#: WhatsNext.py:241
msgid "Families"
msgstr "Šeimos"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Nežinomas ryšio tipas"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Pranešti apie šeimą, kurios ryšio tipas „Nežinomas“"

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Trūksta Santuokos įvykio"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Pranešti apie „Susituokę“ tipo šeimą be Santuokos įvykio"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Santuokos data ir vieta"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Patikrinti Santuokos įvykio datą ir vietą"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Skyrybų data ir vieta"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Patikrinti Skyrybų įvykio datą ir vietą"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Ryšiai"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Trūksta tėvų šeimos"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Išvardyti kiekvieną asmenį, neturintį tėvų šeimos"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Trūksta partnerio"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Pranešti apie šeimą tik su vienu partneriu"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Trūksta tėvo"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Pranešti apie asmenį, kurio tėvų šeimoje nėra tėvo"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Trūksta motinos"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Pranešti apie asmenį, kurio tėvų šeimoje nėra motinos"

#: WhatsNext.py:291
msgid "Events"
msgstr "Įvykiai"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Nežinoma data"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Pranešti apie įvykį be datos"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Data yra tik tekstas"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Pranešti apie datą, kurios Gramps negalėjo perskaityti kaip datos"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Netiksli data"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Pranešti apie intervalą, laikotarpį ar datą su „prieš“, „po“, „apie“, "
"„apytikris“ arba „apskaičiuotas“"

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Nepilna data"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Pranešti apie pavienę datą be dienos ar mėnesio"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Nežinoma vieta"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Pranešti apie įvykį be vietos"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Įveskite trūkstamą vardą lange Taisyti asmenį."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Pridėkite lango Taisyti asmenį kortelėje Įvykiai."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Atverkite įvykį lango Taisyti asmenį kortelėje Įvykiai ir užpildykite jo "
"datą bei vietą."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Atverkite įvykį lango Taisyti šeimą kortelėje Įvykiai ir užpildykite jo datą"
" bei vietą."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr "Pridėkite Santuokos įvykį lango Taisyti šeimą kortelėje Įvykiai."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Pasirinkite ryšio „Rūšį“ lange Taisyti šeimą."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Pridėkite trūkstamą partnerį lange Taisyti šeimą."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Pridėkite tėvą tėvų šeimos lange Taisyti šeimą."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Pridėkite motiną tėvų šeimos lange Taisyti šeimą."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"Rodinyje Ryšiai meniu Taisa pasirinkite „Pridėti naujus tėvus...“ arba "
"„Pasirinkti esamus tėvus...“."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Užbaigta"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Ignoruota"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Apkarpyta"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Vietinė giminės medžio duomenų bazė dar neįkelta.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Tolesni žingsniai:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  Meniu „Giminės medžiai“"

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " pasirinkite „Tvarkyti giminės medžius...“ ir"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " sukurkite naują medžio duomenų bazę (arba pasirinkite esamą).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Spustelėkite mygtuką „Įkelti giminės medį“, kad pradėtumėte"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" dirbti su pasirinktu giminės medžiu.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Norėdami naudoti Gramps atsarginę kopiją arba GEDCOM failą iš kitos genealogijos programos, meniu „Giminės medžiai“ pasirinkite „Įkelti...“.\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Norėdami naudoti Gramps atsarginę kopiją arba GEDCOM failą iš kitos genealogijos programos, pirmiausia sukurkite ir įkelkite naują, tuščią medį. Tada meniu „Giminės medžiai“ pasirinkite „Įkelti...“.\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Programėlės nuostatoms keisti naudokite „Konfigūruoti...“ meniu „Rodymas“."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Tvarkyti gaires"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Užbaigti"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Pažymėti išvardytus asmenis ir šeimas gaire Užbaigta"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Ignoruoti"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Gairė asmenims ir šeimoms ignoruoti"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Apkarpyti"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Gairė išvardytiems asmenims ir šeimoms apkarpyti (pašalinti) iš tikrinimo"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Paieškos kvota "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Mažiausias rodomų eilučių skaičius. Paieška sustoja, kai randama tiek "
"problemų"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Gylis per ciklą"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Kiek palikuonių kartų patikrinti prieš pakylant dar viena protėvių karta"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Pristabdyti paieškos plėtimą"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Kiek papildomų ratų palaukti patikrinus protėvį, prieš tikrinant to protėvio"
" palikuonis"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Gairė Užbaigta"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Baigta. Paslėpti objektą ir toliau ieškoti per jį"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Gairė Ignoruoti"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "Kol kas atidėta. Paslėpti objektą ir toliau ieškoti per jį"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Gairė Apkarpyti"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Aklavietė. Paslėpti objektą ir nustoti ieškoti per jį"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Rodyti siūlomus 👣 tolesnius žingsnius"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Rodyti nurodymų žingsnius ir 👣 pasiūlymus. Išjunkite, jei norite trumpesnio "
"sąrašo"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Peržiūrėti (atverti redaktorių)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Pažymėti kaip Užbaigta"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Pažymėti ignoruoti"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Pažymėti apkarpyti"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Pažymėti kaip %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Dabartinėje medžio duomenų bazėje nėra asmenų.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Tolesni žingsniai:\n"
" Pridėkite šeimą ir asmenį toje šeimoje:\n"
"  • Šeimą galima pridėti per meniu „Pridėti“\n"
"  • Asmenį galima pridėti paspaudus „+“ (pliusas) sutuoktinių skydeliuose („Tėvas/partneris 1“ arba „Motina/partnerė 2“) arba kortelėje „Vaikai“.\n"
"\n"
"Arba importuokite asmenis iš išorinio failo:\n"
"  • Išorinis failas gali užpildyti medį per „Įkelti...“ meniu „Giminės medžiai“."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Joks asmuo nepasirinktas kaip centrinis „Pagrindinis asmuo“.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Tolesni žingsniai:\n"
"  •  Navigatoriaus šoninėje juostoje pasirinkite Asmenų rodinio piktogramą.\n"
"  •  Pasirinkite ką nors, kad jis taptų „Aktyviu asmeniu“.\n"
"  •  Meniu Taisa arba kontekstiniame meniu (dešinysis spustelėjimas) pasirinkite „Nustatyti pagrindiniu asmeniu“.\n"
"\n"
" Taip jis tampa centriniu „Pagrindiniu asmeniu“."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr ""
"Dukart spustelėkite spalvotą tekstą, kad taisytumėte išsamią informaciją"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "centrinis Pagrindinis asmuo"

