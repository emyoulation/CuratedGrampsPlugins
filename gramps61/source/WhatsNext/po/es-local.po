#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Y ahora qué"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplete con sugerencias de temas a investigar"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "¿Y ahora qué?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Ayuda"

#: WhatsNext.py:206
msgid "People"
msgstr "Personas"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Nombre de pila desconocido"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Informar de una persona sin nombre de pila"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Apellido desconocido"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Informar de una persona sin apellido"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Falta el evento Nacimiento"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Informar de una persona sin evento Nacimiento"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Fecha y lugar de nacimiento"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Comprobar la fecha y el lugar del evento Nacimiento"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Falta el evento Fallecimiento"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Informar de una persona sin evento Fallecimiento, cuando Gramps deduce de "
"las fechas de la persona y de sus parientes que la persona ya no vive"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Fecha y lugar de fallecimiento"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Comprobar la fecha y el lugar del evento Fallecimiento"

#: WhatsNext.py:241
msgid "Families"
msgstr "Familias"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Tipo de relación desconocido"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Informar de una familia con el tipo de relación \"Desconocido\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Falta el evento Matrimonio"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Informar de una familia del tipo \"Casados\" sin evento Matrimonio"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Fecha y lugar del matrimonio"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Comprobar la fecha y el lugar del evento Matrimonio"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Fecha y lugar del divorcio"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Comprobar la fecha y el lugar del evento Divorcio"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Relaciones"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Falta la familia de los padres"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Listar cada persona que no tiene familia de los padres"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Falta la pareja"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Informar de una familia con un solo miembro de la pareja"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Falta el padre"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Informar de una persona cuya familia de los padres no tiene padre"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Falta la madre"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Informar de una persona cuya familia de los padres no tiene madre"

#: WhatsNext.py:291
msgid "Events"
msgstr "Eventos"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Fecha desconocida"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Informar de un evento sin fecha"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "La fecha es solo texto"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Informar de una fecha que Gramps no pudo leer como fecha"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Fecha inexacta"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Informar de un rango, un período o una fecha con \"antes de\", \"después "
"de\", \"hacia\", \"estimada\" o \"calculado\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Fecha incompleta"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Informar de una fecha simple sin su día o mes"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Lugar desconocido"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Informar de un evento sin lugar"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Introduzca el nombre que falta en el diálogo Editar persona."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Agréguelo desde la pestaña Eventos del diálogo Editar persona."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Abra el evento en la pestaña Eventos del diálogo Editar persona y complete "
"su fecha y lugar."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Abra el evento en la pestaña Eventos del diálogo Editar familia y complete "
"su fecha y lugar."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Agregue un evento Matrimonio en la pestaña Eventos del diálogo Editar "
"familia."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Elija el \"Tipo\" de relación en el diálogo Editar familia."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Agregue la pareja que falta en el diálogo Editar familia."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr ""
"Agregue el padre en el diálogo Editar familia de la familia de los padres."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr ""
"Agregue la madre en el diálogo Editar familia de la familia de los padres."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"En la vista Relaciones, elija \"Agregar nuevos padres...\" o \"Agregar "
"padres existentes...\" en el menú Editar."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Completado/a"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Ignorado"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Podado"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Todavía no se ha cargado ninguna base de datos local de árbol genealógico.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Próximos pasos:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  En el menú \"Árboles genealógicos\","

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " use la opción \"Administrar árboles genealógicos...\" para"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr ""
" crear una nueva base de datos de árbol (o para seleccionar una "
"existente).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Pulse el botón \"Cargar árbol genealógico\" para empezar"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" a trabajar con el árbol genealógico seleccionado.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Para usar una copia de seguridad de Gramps, o un archivo GEDCOM de otra herramienta genealógica, elija \"Importar...\" en el menú \"Árboles genealógicos\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Para usar una copia de seguridad de Gramps, o un archivo GEDCOM de otra herramienta genealógica, primero cree y cargue un árbol nuevo y vacío. Luego elija \"Importar...\" en el menú \"Árboles genealógicos\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Use \"Configurar...\" en el menú \"Ver\" para cambiar las opciones del "
"gramplet."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Organizar etiquetas"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Completar"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Etiquetar las personas y familias listadas como Completadas"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Ignorar"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Etiquetar para ignorar personas y familias"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Podar"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Etiquetar para podar (excluir) de la comprobación las personas y familias "
"listadas"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Cuota de búsqueda "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"El número mínimo de líneas que mostrar. La búsqueda se detiene en cuanto se "
"encuentran tantos problemas"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Profundidad por vuelta"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Cuántas generaciones de descendientes comprobar antes de subir una "
"generación más de ascendientes"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Pausar la ampliación de la búsqueda"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Cuántas vueltas adicionales esperar después de comprobar un ascendiente "
"antes de comprobar sus descendientes"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Etiqueta de completado"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Terminado. Ocultar el objeto y seguir buscando a través de él"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Etiqueta de ignorado"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Apartado por ahora. Ocultar el objeto y seguir buscando a través de él"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Etiqueta de podado"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr ""
"Callejón sin salida. Ocultar el objeto y dejar de buscar a través de él"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Mostrar los 👣 próximos pasos sugeridos"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Mostrar los pasos de orientación y las 👣 sugerencias. Desactívelo para una "
"lista más corta"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Revisar (abrir editor)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Etiquetar como Completado"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Etiquetar para ignorar"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Etiquetar para podar"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Etiquetar como %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ La base de datos del árbol actual no contiene personas.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Próximos pasos:\n"
" Agregue una familia y una persona en esa familia:\n"
"  • Se puede agregar una familia mediante el menú \"Agregar\"\n"
"  • Se puede agregar una persona pulsando \"+\" (más) en los paneles de la pareja (\"Padre/comp.1\" o \"Madre/comp.2\") o en la pestaña \"Hijos\".\n"
"\n"
"O importe personas desde un archivo externo:\n"
"  • Se puede usar un archivo externo para poblar el árbol mediante \"Importar...\" en el menú \"Árboles genealógicos\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ No se ha elegido ninguna persona como \"Persona inicial\" central.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Próximos pasos:\n"
"  •  Seleccione el icono de la vista Personas en la barra lateral del Navegador.\n"
"  •  Seleccione a alguien para convertirlo en la \"Persona activa\".\n"
"  •  Elija \"Establecer persona inicial\" en el menú Editar o en el menú contextual (clic derecho).\n"
"\n"
" Así se establece como la \"Persona inicial\" central."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Haga doble clic en el texto de color para editar los detalles"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "Persona inicial central"

