#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Co dále"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplet nabízející oblasti výzkumu"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Co dále?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Nápověda"

#: WhatsNext.py:206
msgid "People"
msgstr "Osoby"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Neznámé křestní jméno"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Ohlásit osobu bez křestního jména"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Neznámé příjmení"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Ohlásit osobu bez příjmení"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Chybí událost Narození"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Ohlásit osobu bez události Narození"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Datum a místo narození"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Zkontrolovat datum a místo události Narození"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Chybí událost Úmrtí"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Ohlásit osobu bez události Úmrtí, pokud Gramps podle dat osoby a jejích "
"příbuzných usoudí, že osoba již nežije"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Datum a místo úmrtí"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Zkontrolovat datum a místo události Úmrtí"

#: WhatsNext.py:241
msgid "Families"
msgstr "Rodiny"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Neznámý typ vztahu"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Ohlásit rodinu s typem vztahu \"Neznámý\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Chybí událost Manželství"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Ohlásit rodinu typu \"Manželé\" bez události Manželství"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Datum a místo sňatku"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Zkontrolovat datum a místo události Manželství"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Datum a místo rozvodu"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Zkontrolovat datum a místo události Rozvod"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Vztahy"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Chybí rodina rodičů"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Vypsat každou osobu, která nemá rodinu rodičů"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Chybí partner"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Ohlásit rodinu s jediným partnerem"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Chybí otec"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Ohlásit osobu, jejíž rodina rodičů nemá otce"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Chybí matka"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Ohlásit osobu, jejíž rodina rodičů nemá matku"

#: WhatsNext.py:291
msgid "Events"
msgstr "Události"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Neznámé datum"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Ohlásit událost bez data"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Datum je jen text"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Ohlásit datum, které Gramps nedokázal přečíst jako datum"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Nepřesné datum"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Ohlásit rozsah, období nebo datum s \"před\", \"po\", \"okolo\", \"odhadem\""
" nebo \"vypočteno\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Neúplné datum"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Ohlásit jednoduché datum bez dne nebo měsíce"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Neznámé místo"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Ohlásit událost bez místa"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Zadejte chybějící jméno v dialogu Upravit osobu."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Přidejte na kartě Události v dialogu Upravit osobu."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Otevřete událost na kartě Události v dialogu Upravit osobu a doplňte její "
"datum a místo."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Otevřete událost na kartě Události v dialogu Změnit rodinu a doplňte její "
"datum a místo."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Přidejte událost Manželství na kartě Události v dialogu Změnit rodinu."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Zvolte \"Typ\" vztahu v dialogu Změnit rodinu."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Přidejte chybějícího partnera v dialogu Změnit rodinu."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Přidejte otce v dialogu Změnit rodinu u rodiny rodičů."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Přidejte matku v dialogu Změnit rodinu u rodiny rodičů."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"V pohledu Vztahy zvolte v nabídce Úpravy \"Přidat nové rodiče...\" nebo "
"\"Vybrat existující rodiče...\"."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Vykonáno"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Ignorováno"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Prořezáno"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Zatím nebyla nahrána žádná místní databáze rodokmenu.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Další kroky:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  V nabídce \"Rodokmeny\""

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " použijte volbu \"Spravovat rodokmeny...\" a"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " vytvořte novou databázi rodokmenu (nebo vyberte existující).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Klepněte na tlačítko \"Nahrát rodokmen\" a začněte"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" pracovat s vybraným rodokmenem.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Chcete-li použít zálohu z Gramps nebo soubor GEDCOM z jiného genealogického programu, zvolte \"Import...\" v nabídce \"Rodokmeny\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Chcete-li použít zálohu z Gramps nebo soubor GEDCOM z jiného genealogického programu, nejprve vytvořte a nahrajte nový prázdný rodokmen. Potom zvolte \"Import...\" v nabídce \"Rodokmeny\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr "Nastavení Gramplety změníte volbou \"Nastavit...\" v nabídce \"Zobrazit\"."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Organizovat štítky"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Dokončeno"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Označit vypsané osoby a rodiny štítkem Dokončeno"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Ignorovat"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Štítek pro ignorování osob a rodin"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Prořezat"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr "Štítek pro prořezání (vyloučení) vypsaných osob a rodin z kontroly"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Kvóta hledání "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Nejmenší počet řádků k zobrazení. Hledání se zastaví, jakmile se najde tolik"
" problémů"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Hloubka na cyklus"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Kolik generací potomků zkontrolovat před postupem o další generaci předků "
"výš"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Pozdržet rozšiřování hledání"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Kolik kol navíc počkat po kontrole předka, než se zkontrolují jeho potomci"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Štítek Dokončeno"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Hotovo. Skrýt objekt a dál jím prohledávat"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Štítek Ignorováno"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "Prozatím odloženo. Skrýt objekt a dál jím prohledávat"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Štítek Prořezáno"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Slepá ulička. Skrýt objekt a přestat jím prohledávat"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Zobrazit navrhované 👣 další kroky"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "Zobrazit pokyny a 👣 návrhy. Vypněte pro kratší seznam"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Zkontrolovat (otevřít editor)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Označit jako Dokončeno"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Označit k ignorování"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Označit k prořezání"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Označit jako %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Aktuální databáze rodokmenu neobsahuje žádné osoby.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Další kroky:\n"
" Přidejte rodinu a osobu v této rodině:\n"
"  • Rodinu lze přidat z nabídky \"Přidat\"\n"
"  • Osobu lze přidat stisknutím \"+\" (plus) v panelech partnerů (\"Otec/partner1\" nebo \"Matka/partner2\") nebo na kartě \"Děti\".\n"
"\n"
"Nebo importujte osoby z externího souboru:\n"
"  • Externí soubor lze použít k naplnění rodokmenu přes \"Import...\" v nabídce \"Rodokmeny\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Žádná osoba nebyla zvolena jako ústřední \"Výchozí osoba\".\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Další kroky:\n"
"  •  Vyberte ikonu pohledu Osoby v postranním panelu Navigátoru.\n"
"  •  Vyberte někoho, aby se stal \"Aktivní osobou\".\n"
"  •  Zvolte \"Nastavit výchozí osobu\" v nabídce Úpravy nebo v místní nabídce (pravé tlačítko).\n"
"\n"
" Tím se stane ústřední \"Výchozí osobou\"."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Poklepáním na barevný text upravíte podrobnosti"

