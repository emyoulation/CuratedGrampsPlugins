#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Šta je sledeće"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Dedozorče koje predlaže stavke za istraživanje"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Šta je sledeće?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Pomoć"

#: WhatsNext.py:206
msgid "People"
msgstr "Osobe"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Nepoznato ime"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Prijavi osobu bez imena"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Nepoznato prezime"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Prijavi osobu bez prezimena"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Nedostaje događaj Rođenje"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Prijavi osobu bez događaja Rođenje"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Datum i mesto rođenja"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Proveri datum i mesto događaja Rođenje"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Nedostaje događaj Smrt"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Prijavi osobu bez događaja Smrt kada Gramps prema datumima osobe i njenih "
"srodnika proceni da osoba više nije živa"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Datum i mesto smrti"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Proveri datum i mesto događaja Smrt"

#: WhatsNext.py:241
msgid "Families"
msgstr "Porodice"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Nepoznata vrsta odnosa"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Prijavi porodicu sa vrstom odnosa \"Nepoznato\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Nedostaje događaj Brak"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Prijavi porodicu vrste \"Venčani\" bez događaja Brak"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Datum i mesto venčanja"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Proveri datum i mesto događaja Brak"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Datum i mesto razvoda"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Proveri datum i mesto događaja Razvod"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Srodstva"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Nedostaje porodica roditelja"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Navedi svaku osobu koja nema porodicu roditelja"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Nedostaje partner"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Prijavi porodicu sa samo jednim partnerom"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Nedostaje otac"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Prijavi osobu čija porodica roditelja nema oca"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Nedostaje majka"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Prijavi osobu čija porodica roditelja nema majku"

#: WhatsNext.py:291
msgid "Events"
msgstr "Događaji"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Nepoznat datum"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Prijavi događaj bez datuma"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Datum je samo tekst"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Prijavi datum koji Gramps nije mogao da pročita kao datum"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Netačan datum"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Prijavi opseg, period ili datum sa \"pre\", \"posle\", \"oko\", "
"\"procenjeno\" ili \"proračunato\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Nepotpun datum"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Prijavi pojedinačni datum bez dana ili meseca"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Nepoznato mesto"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Prijavi događaj bez mesta"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Unesite ime koje nedostaje u prozoru Uredite osobu."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Dodajte preko kartice Događaji u prozoru Uredite osobu."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Otvorite događaj na kartici Događaji u prozoru Uredite osobu i dopunite "
"njegov datum i mesto."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Otvorite događaj na kartici Događaji u prozoru Uredi porodicu i dopunite "
"njegov datum i mesto."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr "Dodajte događaj Brak na kartici Događaji u prozoru Uredi porodicu."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Izaberite \"Vrstu\" odnosa u prozoru Uredi porodicu."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Dodajte partnera koji nedostaje u prozoru Uredi porodicu."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Dodajte oca u prozoru Uredi porodicu za porodicu roditelja."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Dodajte majku u prozoru Uredi porodicu za porodicu roditelja."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"U pregledu Srodstva izaberite \"Dodaj nove roditelje...\" ili \"Dodaj "
"postojeće roditelje...\" iz menija Uređivanje."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Završeno"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Zanemareno"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Orezano"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Još nije učitana lokalna baza podataka porodičnog stabla.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Sledeći koraci:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  U meniju \"Porodična stabla\""

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " upotrebite opciju \"Upravljaj porodičnim stablima...\" da biste"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " napravili novu bazu podataka stabla (ili izabrali postojeću).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Kliknite na dugme \"Učitaj porodično stablo\" da biste počeli"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" da radite sa izabranim porodičnim stablom.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Da biste upotrebili rezervnu kopiju iz Gramps-a ili GEDCOM datoteku iz drugog genealoškog alata, izaberite \"Uvezi...\" u meniju \"Porodična stabla\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Da biste upotrebili rezervnu kopiju iz Gramps-a ili GEDCOM datoteku iz drugog genealoškog alata, prvo napravite i učitajte novo, prazno stablo. Zatim izaberite \"Uvezi...\" u meniju \"Porodična stabla\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Upotrebite \"Podesi...\" u meniju \"Pregled\" da biste promenili opcije "
"grampleta."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Sredi oznake"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Završeno"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Označi navedene osobe i porodice kao Završeno"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Zanemari"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Oznaka za zanemarivanje osoba i porodica"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Oreži"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Oznaka za orezivanje (isključivanje) navedenih osoba i porodica iz provere"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Kvota pretrage "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Najmanji broj redova za prikaz. Pretraga se zaustavlja kada se pronađe "
"toliko problema"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Dubina po krugu"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Koliko generacija potomaka proveriti pre prelaska jednu generaciju predaka "
"više"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Pauziraj širenje pretrage"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Koliko dodatnih krugova sačekati posle provere pretka pre provere potomaka "
"tog pretka"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Oznaka Završeno"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Gotovo. Sakrij objekat i nastavi pretragu kroz njega"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Oznaka Zanemareno"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Zasad ostavljeno po strani. Sakrij objekat i nastavi pretragu kroz njega"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Oznaka Orezano"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Ćorsokak. Sakrij objekat i zaustavi pretragu kroz njega"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Prikaži predložene 👣 sledeće korake"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "Prikaži korake vodiča i 👣 predloge. Isključite za kraći spisak"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Pregledaj (otvori uređivač)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Označi kao Završeno"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Označi za zanemarivanje"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Označi za orezivanje"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Označi kao %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Trenutna baza podataka stabla ne sadrži osobe.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Sledeći koraci:\n"
" Dodajte porodicu i osobu u toj porodici:\n"
"  • Porodica se može dodati preko menija \"Dodaj\"\n"
"  • Osoba se može dodati pritiskom na \"+\" (plus) u panelima supružnika (\"Otac/partner1\" ili \"Majka/partner2\") ili na kartici \"Deca\".\n"
"\n"
"Ili uvezite osobe iz spoljne datoteke:\n"
"  • Spoljna datoteka može se upotrebiti za popunjavanje stabla preko \"Uvezi...\" u meniju \"Porodična stabla\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Nijedna osoba nije izabrana kao centralna \"Osnovna osoba\".\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Sledeći koraci:\n"
"  •  Izaberite ikonicu pregleda Osobe u bočnoj traci Navigatora.\n"
"  •  Izaberite nekoga da postane \"Aktivna osoba\".\n"
"  •  Izaberite \"Postavi početnu osobu\" iz menija Uređivanje ili iz kontekstnog menija (desni klik).\n"
"\n"
" Tako postaje centralna \"Osnovna osoba\"."

#: WhatsNext.py:1645
