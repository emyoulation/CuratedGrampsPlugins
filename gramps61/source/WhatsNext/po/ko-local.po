msgstr "%(str1)s: %(str2)s"

#: WhatsNext.py:2204
msgid "A partner relationship exists but the spouse is missing"
msgstr "배우자 관계는 있으나 배우자가 없습니다"

#: WhatsNext.py:2216
msgid "Father missing from the parent family"
msgstr "부모 가족에 아버지 누락"

#: WhatsNext.py:2227
msgid "Mother missing from the parent family"
msgstr "부모 가족에 어머니 누락"

#: WhatsNext.py:2237
msgid "Parent family is unknown."
msgstr "부모 가족을 알 수 없습니다."

#: WhatsNext.py:2254
#, python-format
msgid ": %s\n"
msgstr ": %s\n"
