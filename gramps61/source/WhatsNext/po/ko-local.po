msgstr "이름 알 수 없음"

#: WhatsNext.py:1994
msgid "surname unknown"
msgstr "성 알 수 없음"

#: WhatsNext.py:2000
msgid "Birth event missing"
msgstr "출생 사건 누락"

#: WhatsNext.py:2011
msgid "Death event missing"
msgstr "사망 사건 누락"

#: WhatsNext.py:2129
msgid "marriage event missing"
msgstr "결혼 사건 누락"

#: WhatsNext.py:2133
msgid "relationship type unknown"
msgstr "관계 유형 알 수 없음"

#: WhatsNext.py:2167
msgid "date unknown"
msgstr "날짜 알 수 없음"

#: WhatsNext.py:2170
msgid "date is text only"
msgstr "날짜가 텍스트로만 되어 있음"

#: WhatsNext.py:2175
msgid "date inexact"
msgstr "날짜 부정확"

#: WhatsNext.py:2178
msgid "date incomplete"
msgstr "날짜 불완전"

