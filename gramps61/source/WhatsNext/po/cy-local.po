msgid "Date is text only"
msgstr "Testun yn unig yw'r dyddiad"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Adrodd am ddyddiad na allai Gramps ei ddarllen fel dyddiad"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Dyddiad anfanwl"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Adrodd am ystod, cyfnod, neu ddyddiad gydag \"cyn\", \"ar ôl\", \"tua\", "
"\"amcangyfrifedig\" neu \"cyfrifedig\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Dyddiad anghyflawn"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Adrodd am ddyddiad unigol heb ei ddiwrnod na'i fis"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Lle anhysbys"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Adrodd am ddigwyddiad heb le"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Rhowch yr enw coll yn y blwch deialog Golygu Person."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Ychwanegwch drwy dab Digwyddiadau y blwch deialog Golygu Person."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Agorwch y digwyddiad ar dab Digwyddiadau y blwch deialog Golygu Person, a "
"chwblhewch ei ddyddiad a'i le."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Agorwch y digwyddiad ar dab Digwyddiadau y blwch deialog Golygu Teulu, a "
"chwblhewch ei ddyddiad a'i le."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Ychwanegwch ddigwyddiad Priodas ar dab Digwyddiadau y blwch deialog Golygu "
"Teulu."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Dewiswch \"Math\" y berthynas yn y blwch deialog Golygu Teulu."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Ychwanegwch y partner coll yn y blwch deialog Golygu Teulu."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr ""
"Ychwanegwch y tad yn y blwch deialog Golygu Teulu ar gyfer teulu'r rhieni."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr ""
"Ychwanegwch y fam yn y blwch deialog Golygu Teulu ar gyfer teulu'r rhieni."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"Yn y wedd Perthnasoedd, dewiswch \"Ychwanegu Rhieni Newydd...\" neu "
"\"Ychwanegu Rhieni Presennol...\" o'r ddewislen Golygu."

