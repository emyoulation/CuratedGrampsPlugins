msgstr "Trefnu Tagiau"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Cwblhau"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Tagio'r Bobl a'r Teuluoedd a restrwyd fel Cwblhawyd"

