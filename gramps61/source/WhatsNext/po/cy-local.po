msgid "Report a family with the relationship type \"Unknown\""
msgstr "Adrodd am deulu â'r math o berthynas \"Anhysbys\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Digwyddiad Priodas ar goll"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Adrodd am deulu o'r math \"Priod\" heb ddigwyddiad Priodas"

