msgid "%(str1)s: %(str2)s"
msgstr "%(str1)s: %(str2)s"

#: WhatsNext.py:2204
msgid "A partner relationship exists but the spouse is missing"
msgstr "رابطهٔ همسری وجود دارد اما همسر موجود نیست"

#: WhatsNext.py:2216
msgid "Father missing from the parent family"
msgstr "پدر در خانوادهٔ والدین موجود نیست"

#: WhatsNext.py:2227
msgid "Mother missing from the parent family"
msgstr "مادر در خانوادهٔ والدین موجود نیست"

#: WhatsNext.py:2237
msgid "Parent family is unknown."
msgstr "خانوادهٔ والدین ناشناخته است."

#: WhatsNext.py:2254
#, python-format
msgid ": %s\n"
msgstr ": %s\n"
