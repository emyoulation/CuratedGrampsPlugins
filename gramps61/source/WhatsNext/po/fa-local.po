#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "بعدی چیست"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "گرمپلتی که موارد پژوهشی پیشنهاد می‌دهد"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "بعدی چیست؟"

#: WhatsNext.py:129
msgid "Help"
msgstr "راهنما"

#: WhatsNext.py:206
msgid "People"
msgstr "نفرات"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "نام کوچک ناشناخته"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "گزارش شخص بدون نام کوچک"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "نام خانوادگی ناشناخته"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "گزارش شخص بدون نام خانوادگی"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "رویداد تولد موجود نیست"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "گزارش شخص بدون رویداد تولد"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "تاریخ و محل تولد"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "بررسی تاریخ و محل رویداد تولد"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "رویداد درگذشت موجود نیست"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"گزارش شخص بدون رویداد درگذشت، هنگامی که Gramps از تاریخ‌های شخص و "
"خویشاوندانش نتیجه بگیرد که شخص دیگر در قید حیات نیست"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "تاریخ و محل درگذشت"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "بررسی تاریخ و محل رویداد درگذشت"

#: WhatsNext.py:241
msgid "Families"
msgstr "خانواده‌ها"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "نوع رابطهٔ ناشناخته"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "گزارش خانواده‌ای با نوع رابطهٔ «ناشناخته»"

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "رویداد ازدواج موجود نیست"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "گزارش خانواده‌ای از نوع «متأهل» بدون رویداد ازدواج"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "تاریخ و محل ازدواج"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "بررسی تاریخ و محل رویداد ازدواج"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "تاریخ و محل طلاق"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "بررسی تاریخ و محل رویداد طلاق"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "روابط"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "خانوادهٔ والدین موجود نیست"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "فهرست هر شخصی که خانوادهٔ والدین ندارد"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "همسر موجود نیست"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "گزارش خانواده‌ای که فقط یک همسر دارد"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "پدر موجود نیست"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "گزارش شخصی که خانوادهٔ والدینش پدر ندارد"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "مادر موجود نیست"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "گزارش شخصی که خانوادهٔ والدینش مادر ندارد"

#: WhatsNext.py:291
msgid "Events"
msgstr "رویدادها"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "تاریخ ناشناخته"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "گزارش رویداد بدون تاریخ"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "تاریخ فقط متن است"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "گزارش تاریخی که Gramps نتوانست آن را به‌عنوان تاریخ بخواند"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "تاریخ نادقیق"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"گزارش یک بازه، یک دوره، یا تاریخی با «قبل از»، «بعد از»، «حدود»، «تخمینی» یا"
" «محاسبه‌شده»"

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "تاریخ ناقص"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "گزارش تاریخ تکی بدون روز یا ماه"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "محل ناشناخته"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "گزارش رویداد بدون محل"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "نام گم‌شده را در پنجرهٔ ویرایش شخص وارد کنید."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "از طریق زبانهٔ رویدادها در پنجرهٔ ویرایش شخص اضافه کنید."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"رویداد را در زبانهٔ رویدادهای پنجرهٔ ویرایش شخص باز کنید و تاریخ و محل آن را"
" کامل کنید."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"رویداد را در زبانهٔ رویدادهای پنجرهٔ ویرایش خانواده باز کنید و تاریخ و محل "
"آن را کامل کنید."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"یک رویداد ازدواج در زبانهٔ رویدادهای پنجرهٔ ویرایش خانواده اضافه کنید."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "«نوع» رابطه را در پنجرهٔ ویرایش خانواده انتخاب کنید."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "همسر گم‌شده را در پنجرهٔ ویرایش خانواده اضافه کنید."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "پدر را در پنجرهٔ ویرایش خانوادهٔ خانوادهٔ والدین اضافه کنید."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "مادر را در پنجرهٔ ویرایش خانوادهٔ خانوادهٔ والدین اضافه کنید."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"در نمای روابط، از منوی ویرایش «افزودن والدین جدید...» یا «افزودن والدین "
"موجود...» را انتخاب کنید."

#: WhatsNext.py:400
msgid "Completed"
msgstr "تکمیل‌شده"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "نادیده گرفته‌شده"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "هرس‌شده"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ هنوز هیچ پایگاه دادهٔ محلی شجره‌نامه بارگذاری نشده است.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 گام‌های بعدی:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  از منوی «شجره‌نامه‌ها»،"

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " با گزینهٔ «مدیریت شجره‌نامه‌ها...»"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr ""
" یک پایگاه دادهٔ شجره‌نامهٔ جدید بسازید (یا یکی از موجودها را انتخاب "
"کنید).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  روی دکمهٔ «بارگذاری شجره‌نامه» کلیک کنید تا"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" کار با شجره‌نامهٔ انتخاب‌شده آغاز شود.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"برای استفاده از پشتیبان Gramps یا پروندهٔ GEDCOM از ابزار تبارشناسی دیگر، «وارد کردن...» را در منوی «شجره‌نامه‌ها» انتخاب کنید.\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"برای استفاده از پشتیبان Gramps یا پروندهٔ GEDCOM از ابزار تبارشناسی دیگر، ابتدا یک شجره‌نامهٔ جدید و خالی بسازید و بارگذاری کنید. سپس «وارد کردن...» را در منوی «شجره‌نامه‌ها» انتخاب کنید.\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr "برای تغییر گزینه‌های گرمپلت از «پیکربندی» در منوی «نما» استفاده کنید."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "سازماندهی برچسب‌ها"

#: WhatsNext.py:719
msgid "Complete"
msgstr "تکمیل"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "برچسب «تکمیل‌شده» برای اشخاص و خانواده‌های فهرست‌شده"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "نادیده گرفتن"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "برچسب نادیده گرفتن برای اشخاص و خانواده‌ها"

#: WhatsNext.py:739
msgid "Prune"
msgstr "هرس"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr "برچسب هرس (کنار گذاشتن) اشخاص و خانواده‌های فهرست‌شده از بررسی"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "سهمیهٔ جستجو "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"کمترین تعداد سطرها برای نمایش. جستجو پس از یافتن این تعداد مشکل متوقف می‌شود"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "عمق در هر دور"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"تعداد نسل‌های نوادگان که پیش از بالا رفتن یک نسل دیگر از نیاکان بررسی "
"می‌شوند"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "توقف گسترش جستجو"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"تعداد دورهای اضافی برای انتظار پس از بررسی یک نیا و پیش از بررسی نوادگان آن "
"نیا"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "برچسب تکمیل"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "تمام‌شده. شیء را پنهان کن و جستجو را از میان آن ادامه بده"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "برچسب نادیده گرفتن"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"فعلاً کنار گذاشته‌شده. شیء را پنهان کن و جستجو را از میان آن ادامه بده"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "برچسب هرس"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "بن‌بست. شیء را پنهان کن و جستجو را از میان آن متوقف کن"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "نمایش 👣 گام‌های بعدی پیشنهادی"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "نمایش گام‌های راهنما و 👣 پیشنهادها. برای فهرستی کوتاه‌تر خاموش کنید"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_بازبینی (باز کردن ویرایشگر)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "برچسب تکمیل‌شده"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "برچسب نادیده گرفتن"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "برچسب هرس"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "برچسب %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ پایگاه دادهٔ شجره‌نامهٔ فعلی هیچ شخصی ندارد.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 گام‌های بعدی:\n"
" یک خانواده و یک شخص در آن خانواده اضافه کنید:\n"
"  • خانواده را می‌توان از منوی «افزودن» اضافه کرد\n"
"  • شخص را می‌توان با فشردن «+» (به‌علاوه) در قاب‌های همسران («پدر/همسر۱» یا «مادر/همسر۲») یا زبانهٔ «فرزندان» اضافه کرد.\n"
"\n"
"یا اشخاص را از یک پروندهٔ بیرونی وارد کنید:\n"
"  • با «وارد کردن...» در منوی «شجره‌نامه‌ها» می‌توان از یک پروندهٔ بیرونی برای پر کردن شجره‌نامه استفاده کرد."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ هیچ شخصی به‌عنوان «شخص خانه» کانونی انتخاب نشده است.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 گام‌های بعدی:\n"
"  •  نماد نمای اشخاص را در نوار کناری ناوبر انتخاب کنید.\n"
"  •  کسی را انتخاب کنید تا «شخص فعال» شود.\n"
"  •  «تنظیم شخص خانه» را از منوی ویرایش یا منوی زمینه (کلیک راست) انتخاب کنید.\n"
"\n"
" این کار او را «شخص خانه» کانونی می‌کند."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "برای ویرایش جزئیات روی متن رنگی دوبار کلیک کنید"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "شخص خانهٔ کانونی"

#: WhatsNext.py:1847 WhatsNext.py:1858
msgid "(person with unknown name)"
msgstr "(شخص با نام ناشناخته)"

#: WhatsNext.py:1857
msgid "(unknown person)"
msgstr "(شخص ناشناخته)"

