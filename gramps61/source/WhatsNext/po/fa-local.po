msgid "first name unknown"
msgstr "نام کوچک ناشناخته"

#: WhatsNext.py:1994
msgid "surname unknown"
msgstr "نام خانوادگی ناشناخته"

#: WhatsNext.py:2000
msgid "Birth event missing"
msgstr "رویداد تولد موجود نیست"

#: WhatsNext.py:2011
msgid "Death event missing"
msgstr "رویداد درگذشت موجود نیست"

#: WhatsNext.py:2129
msgid "marriage event missing"
msgstr "رویداد ازدواج موجود نیست"

#: WhatsNext.py:2133
msgid "relationship type unknown"
msgstr "نوع رابطه ناشناخته"

#: WhatsNext.py:2167
msgid "date unknown"
msgstr "تاریخ ناشناخته"

#: WhatsNext.py:2170
msgid "date is text only"
msgstr "تاریخ فقط متن است"

#: WhatsNext.py:2175
msgid "date inexact"
msgstr "تاریخ نادقیق"

#: WhatsNext.py:2178
msgid "date incomplete"
msgstr "تاریخ ناقص"

#: WhatsNext.py:2181
msgid "place unknown for the Event"
msgstr "محل رویداد ناشناخته"

