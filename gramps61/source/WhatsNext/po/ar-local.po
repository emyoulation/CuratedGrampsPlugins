msgstr "شريط معلومات لعرض اقتراحات للبحث فيها"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "ما التالي؟"

#: WhatsNext.py:129
msgid "Help"
msgstr "مساعدة"

#: WhatsNext.py:206
msgid "People"
msgstr "أشخاص"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "اسم أول مجهول"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "الإبلاغ عن شخص بدون اسم أول"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "اسم عائلة مجهول"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "الإبلاغ عن شخص بدون اسم عائلة"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "حدث ميلاد مفقود"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "الإبلاغ عن شخص بدون حدث ميلاد"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "تاريخ ومكان الميلاد"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "التحقق من تاريخ ومكان حدث الميلاد"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "حدث ممات مفقود"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"الإبلاغ عن شخص بدون حدث ممات، عندما يستنتج Gramps من تواريخ الشخص وأقاربه "
"أنه لم يعد على قيد الحياة"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "تاريخ ومكان الممات"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "التحقق من تاريخ ومكان حدث الممات"

#: WhatsNext.py:241
msgid "Families"
msgstr "عائلات"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "نوع علاقة مجهول"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "الإبلاغ عن عائلة نوع علاقتها \"مجهول\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "حدث زواج مفقود"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "الإبلاغ عن عائلة من نوع \"زواج\" بدون حدث زواج"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "تاريخ ومكان الزواج"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "التحقق من تاريخ ومكان حدث الزواج"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "تاريخ ومكان الطلاق"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "التحقق من تاريخ ومكان حدث الطلاق"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "قرابات"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "عائلة الوالدين مفقودة"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "سرد كل شخص ليست له عائلة والدين"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "شريك مفقود"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "الإبلاغ عن عائلة بشريك واحد فقط"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "أب مفقود"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "الإبلاغ عن شخص ليس في عائلة والديه أب"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "أم مفقودة"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "الإبلاغ عن شخص ليست في عائلة والديه أم"

#: WhatsNext.py:291
msgid "Events"
msgstr "أحداث"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "تاريخ مجهول"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "الإبلاغ عن حدث بدون تاريخ"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "التاريخ نص فقط"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "الإبلاغ عن تاريخ لم يتمكن Gramps من قراءته كتاريخ"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "تاريخ غير دقيق"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"الإبلاغ عن نطاق أو فترة أو تاريخ مع \"قبل\" أو \"بعد\" أو \"حول\" أو "
"\"متوقع\" أو \"محسوب\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "تاريخ غير مكتمل"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "الإبلاغ عن تاريخ مفرد بدون اليوم أو الشهر"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "مكان مجهول"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "الإبلاغ عن حدث بدون مكان"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "أدخل الاسم المفقود في مربع حوار تحرير شخص."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "أضفه من تبويب أحداث في مربع حوار تحرير شخص."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"افتح الحدث في تبويب أحداث في مربع حوار تحرير شخص، وأكمل تاريخه ومكانه."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"افتح الحدث في تبويب أحداث في مربع حوار تحرير العائلة، وأكمل تاريخه ومكانه."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr "أضف حدث زواج في تبويب أحداث في مربع حوار تحرير العائلة."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "اختر \"نوع\" العلاقة في مربع حوار تحرير العائلة."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "أضف الشريك المفقود في مربع حوار تحرير العائلة."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "أضف الأب في مربع حوار تحرير العائلة لعائلة الوالدين."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "أضف الأم في مربع حوار تحرير العائلة لعائلة الوالدين."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"في عرض قرابات، اختر \"إضافة أبوان جديدان...\" أو \"إضافة آباء موجودون من "
"قبل...\" من قائمة تحرير."

#: WhatsNext.py:400
msgid "Completed"
msgstr "إكتمل"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "متجاهَل"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "مُشذَّب"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ لم يتم تحميل قاعدة بيانات شجرة أنساب محلية بعد.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 الخطوات التالية:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  من قائمة \"أشجار عائلة\"،"

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " استخدم خيار \"إدارة أشجار العائلة...\""

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " لإنشاء قاعدة بيانات شجرة جديدة (أو لاختيار شجرة موجودة).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  انقر زر \"فتح شجرة العائلة\""

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" لبدء العمل مع شجرة الأنساب المختارة.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"لاستخدام نسخة احتياطية من Gramps، أو ملف GEDCOM من أداة أنساب أخرى، اختر \"استيراد...\" في قائمة \"أشجار عائلة\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"لاستخدام نسخة احتياطية من Gramps، أو ملف GEDCOM من أداة أنساب أخرى، أنشئ أولًا شجرة جديدة فارغة وافتحها. ثم اختر \"استيراد...\" في قائمة \"أشجار عائلة\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr "استخدم \"تهيئة\" في قائمة \"عرض\" لتغيير خيارات الأداة (Gramplet)."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "تنظيم الوسوم"

#: WhatsNext.py:719
msgid "Complete"
msgstr "مُكتمل"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "وسم الأشخاص والعائلات المدرجة كمكتملة"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "تجاهل"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "وسم الأشخاص والعائلات للتجاهل"

#: WhatsNext.py:739
msgid "Prune"
msgstr "تشذيب"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr "وسم الأشخاص والعائلات المدرجة للتشذيب (الاستبعاد) من الفحص"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "حصة البحث "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"أقل عدد من الأسطر للعرض. يتوقف البحث عند العثور على هذا العدد من المشكلات"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "العمق لكل دورة"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr "عدد أجيال الذرية التي يتم فحصها قبل الصعود جيلًا آخر من الأسلاف"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "إيقاف توسيع البحث مؤقتًا"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr "عدد الجولات الإضافية للانتظار بعد فحص سلف قبل فحص ذرية ذلك السلف"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "وسم الاكتمال"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "منتهٍ. إخفاء العنصر، ومتابعة البحث من خلاله"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "وسم التجاهل"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "مؤجل حاليًا. إخفاء العنصر، ومتابعة البحث من خلاله"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "وسم التشذيب"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "طريق مسدود. إخفاء العنصر، وإيقاف البحث من خلاله"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "عرض 👣 الخطوات التالية المقترحة"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "عرض خطوات الإرشاد و👣 الاقتراحات. أوقفه للحصول على قائمة أقصر"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_مراجعة (فتح المحرر)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "وسم كمكتمل"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "وسم للتجاهل"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "وسم للتشذيب"

