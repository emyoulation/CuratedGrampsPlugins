#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Hvað er á döfinni"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplingur sem stingur upp á atriðum til að rannsaka"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Hvað er á döfinni?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Hjálp"

#: WhatsNext.py:206
msgid "People"
msgstr "Einstaklingar"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Óþekkt eiginnafn"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Tilkynna einstakling án eiginnafns"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Óþekkt kenninafn"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Tilkynna einstakling án kenninafns"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Fæðingaratburð vantar"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Tilkynna einstakling án Fæðingaratburðar"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Fæðingardagur og -staður"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Athuga dagsetningu og stað Fæðingaratburðarins"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Andlátsatburð vantar"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Tilkynna einstakling án Andlátsatburðar, þegar Gramps metur út frá "
"dagsetningum einstaklingsins og ættingja hans að hann sé ekki lengur á lífi"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Dánardagur og -staður"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Athuga dagsetningu og stað Andlátsatburðarins"

#: WhatsNext.py:241
msgid "Families"
msgstr "Fjölskyldur"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Óþekkt gerð tengsla"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Tilkynna fjölskyldu með tengslagerðina \"Óþekkt\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Brúðkaupsatburð vantar"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Tilkynna fjölskyldu af gerðinni \"Hjónaband\" án Brúðkaupsatburðar"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Dagsetning og staður brúðkaups"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Athuga dagsetningu og stað Brúðkaupsatburðarins"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Dagsetning og staður skilnaðar"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Athuga dagsetningu og stað Skilnaðaratburðarins"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Vensl"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Foreldrafjölskyldu vantar"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Telja upp hvern einstakling sem á enga foreldrafjölskyldu"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Maka vantar"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Tilkynna fjölskyldu með aðeins einn maka"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Föður vantar"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Tilkynna einstakling þar sem foreldrafjölskyldan hefur engan föður"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Móður vantar"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Tilkynna einstakling þar sem foreldrafjölskyldan hefur enga móður"

#: WhatsNext.py:291
msgid "Events"
msgstr "Atburðir"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Óþekkt dagsetning"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Tilkynna atburð án dagsetningar"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Dagsetning er aðeins texti"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Tilkynna dagsetningu sem Gramps gat ekki lesið sem dagsetningu"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Ónákvæm dagsetning"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Tilkynna bil, tímabil eða dagsetningu með \"fyrir\", \"eftir\", \"um\", "
"\"áætlað\" eða \"reiknað\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Ófullgerð dagsetning"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Tilkynna staka dagsetningu án dags eða mánaðar"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Óþekktur staður"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Tilkynna atburð án staðar"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Sláðu inn nafnið sem vantar í glugganum Breyta einstaklingi."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Bættu við á flipanum Atburðir í glugganum Breyta einstaklingi."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Opnaðu atburðinn á flipanum Atburðir í glugganum Breyta einstaklingi og "
"fylltu út dagsetningu og stað."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Opnaðu atburðinn á flipanum Atburðir í glugganum Breyta fjölskyldu og fylltu"
" út dagsetningu og stað."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Bættu Brúðkaupsatburði við á flipanum Atburðir í glugganum Breyta "
"fjölskyldu."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Veldu \"Gerð\" tengsla í glugganum Breyta fjölskyldu."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Bættu makanum sem vantar við í glugganum Breyta fjölskyldu."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr ""
"Bættu föðurnum við í glugganum Breyta fjölskyldu fyrir foreldrafjölskylduna."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr ""
"Bættu móðurinni við í glugganum Breyta fjölskyldu fyrir "
"foreldrafjölskylduna."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"Í Vensla-sýninni skaltu velja \"Bæta við nýjum foreldrum...\" eða \"Bæta við"
" skráðum foreldrum...\" í valmyndinni Breyta."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Frágengin"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Hunsað"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Snyrt"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Enginn staðbundinn ættartölugagnagrunnur hefur enn verið hlaðinn inn.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Næstu skref:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  Í valmyndinni \"Ættartölur\","

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " notaðu valkostinn \"Sýsla með ættartölur...\" til að"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " búa til nýjan ættartölugagnagrunn (eða velja fyrirliggjandi).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Smelltu á hnappinn \"Hlaða inn ættartölu\" til að byrja"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" að vinna með valda ættartölu.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Til að nota öryggisafrit úr Gramps, eða GEDCOM-skrá úr öðru ættfræðiforriti, skaltu velja \"Flytja inn...\" í valmyndinni \"Ættartölur\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Til að nota öryggisafrit úr Gramps, eða GEDCOM-skrá úr öðru ættfræðiforriti, skaltu fyrst búa til og hlaða inn nýrri, tómri ættartölu. Veldu síðan \"Flytja inn...\" í valmyndinni \"Ættartölur\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Notaðu \"Stillingar...\" í valmyndinni \"Skoða\" til að breyta valkostum "
"smáforritsins."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Skipuleggja merki"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Fullkláruð"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Merkja upptalda einstaklinga og fjölskyldur sem Lokið"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Hunsa"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Merkja til að hunsa einstaklinga og fjölskyldur"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Snyrta"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Merkja til að snyrta (útiloka) upptalda einstaklinga og fjölskyldur frá "
"prófun"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Leitarkvóti "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Minnsti fjöldi lína sem birtist. Leitin stöðvast þegar svo mörg vandamál "
"hafa fundist"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Dýpt í hverri lotu"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Hversu margar kynslóðir afkomenda skal athuga áður en farið er upp um eina "
"kynslóð forfeðra í viðbót"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Gera hlé á útvíkkun leitar"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Hversu margar aukalotur skal bíða eftir að forfaðir er athugaður áður en "
"afkomendur hans eru athugaðir"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Merki Lokið"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Lokið. Fela hlutinn og halda áfram að leita í gegnum hann"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Merki Hunsa"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Lagt til hliðar í bili. Fela hlutinn og halda áfram að leita í gegnum hann"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Merki Snyrta"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Blindgata. Fela hlutinn og hætta að leita í gegnum hann"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Sýna tillögð 👣 næstu skref"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Sýna leiðbeiningarskrefin og 👣 tillögurnar. Slökktu á fyrir styttri lista"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Yfirfara (opna ritil)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Merkja sem Lokið"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Merkja til að hunsa"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Merkja til að snyrta"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Merkja sem %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Núverandi ættartölugagnagrunnur inniheldur enga einstaklinga.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Næstu skref:\n"
" Bættu við fjölskyldu og einstaklingi í þá fjölskyldu:\n"
"  • Hægt er að bæta við fjölskyldu í valmyndinni \"Bæta við\"\n"
"  • Hægt er að bæta við einstaklingi með því að ýta á \"+\" (plús) í makaspjöldunum (\"Faðir/sambýlingur1\" eða \"Móðir/sambýlingur2\") eða á flipanum \"Börn\".\n"
"\n"
"Eða flyttu inn einstaklinga úr ytri skrá:\n"
"  • Hægt er að nota ytri skrá til að fylla ættartöluna með \"Flytja inn...\" í valmyndinni \"Ættartölur\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Enginn einstaklingur hefur verið valinn sem miðlægur \"Sjálfgefinn einstaklingur\".\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Næstu skref:\n"
"  •  Veldu táknmynd Einstaklinga-sýnarinnar í hliðarstiku Leiðsagnar.\n"
"  •  Veldu einhvern til að gera hann að \"Virkum einstaklingi\".\n"
"  •  Veldu \"Stilla upphafseinstakling\" í valmyndinni Breyta eða í samhengisvalmyndinni (hægrismella).\n"
"\n"
" Þetta gerir hann að miðlægum \"Sjálfgefnum einstaklingi\"."

