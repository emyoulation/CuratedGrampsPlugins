#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Hva nå?"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplet som foreslår hva man bør forske mer på"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Hva nå?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Hjelp"

#: WhatsNext.py:206
msgid "People"
msgstr "Personer"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Ukjent fornavn"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Rapporter en person uten fornavn"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Ukjent etternavn"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Rapporter en person uten etternavn"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Mangler Fødsel-hendelse"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Rapporter en person uten Fødsel-hendelse"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Fødselsdato og -sted"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Kontroller dato og sted for Fødsel-hendelsen"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Mangler Død-hendelse"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Rapporter en person uten Død-hendelse, når Gramps ut fra datoene til "
"personen og slektningene vurderer at personen ikke lenger lever"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Dødsdato og -sted"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Kontroller dato og sted for Død-hendelsen"

#: WhatsNext.py:241
msgid "Families"
msgstr "Familier"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Ukjent relasjonstype"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Rapporter en familie med relasjonstypen \"Ukjent\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Mangler Ekteskap-hendelse"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Rapporter en familie av typen \"Gift\" uten Ekteskap-hendelse"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Vigselsdato og -sted"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Kontroller dato og sted for Ekteskap-hendelsen"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Skilsmissedato og -sted"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Kontroller dato og sted for Skilsmisse-hendelsen"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Slektskap"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Mangler foreldrefamilie"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "List opp hver person som ikke har noen foreldrefamilie"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Mangler partner"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Rapporter en familie med bare én partner"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Mangler far"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Rapporter en person der foreldrefamilien ikke har noen far"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Mangler mor"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Rapporter en person der foreldrefamilien ikke har noen mor"

#: WhatsNext.py:291
msgid "Events"
msgstr "Hendelser"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Ukjent dato"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Rapporter en hendelse uten dato"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Dato er bare tekst"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Rapporter en dato som Gramps ikke kunne lese som en dato"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Upresis dato"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Rapporter et intervall, et tidsrom eller en dato med \"før\", \"etter\", "
"\"omkring\", \"estimert\" eller \"beregnet\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Ufullstendig dato"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Rapporter en enkeltdato uten dag eller måned"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Ukjent sted"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Rapporter en hendelse uten sted"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Skriv inn navnet som mangler i dialogen Rediger person."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Legg til via fanen Hendelser i dialogen Rediger person."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Åpne hendelsen i fanen Hendelser i dialogen Rediger person, og fyll ut dato "
"og sted."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Åpne hendelsen i fanen Hendelser i dialogen Rediger familie, og fyll ut dato"
" og sted."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Legg til en Ekteskap-hendelse i fanen Hendelser i dialogen Rediger familie."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Velg relasjonens \"Type\" i dialogen Rediger familie."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Legg til partneren som mangler i dialogen Rediger familie."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Legg til faren i dialogen Rediger familie for foreldrefamilien."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Legg til moren i dialogen Rediger familie for foreldrefamilien."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"I visningen Slektskap velger du \"Opprett nye foreldre...\" eller \"Velg "
"eksisterende foreldre...\" fra menyen Rediger."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Fullført"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Ignorert"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Beskåret"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Ingen lokal slektstre-database er lastet inn ennå.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Neste trinn:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  Fra menyen \"Slektstrær\""

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " bruker du \"Administrer slektstrær...\" for å"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " opprette en ny slektstre-database (eller velge en eksisterende).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Klikk på knappen \"Åpne Slektstre\" for å begynne"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" å arbeide med det valgte slektstreet.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"For å bruke en sikkerhetskopi fra Gramps, eller en GEDCOM-fil fra et annet slektsprogram, velger du \"Importer...\" i menyen \"Slektstrær\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"For å bruke en sikkerhetskopi fra Gramps, eller en GEDCOM-fil fra et annet slektsprogram, oppretter og åpner du først et nytt, tomt slektstre. Velg deretter \"Importer...\" i menyen \"Slektstrær\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Bruk \"Konfigurer...\" i menyen \"Vis\" for å endre innstillingene til "
"Grampleten."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Organiser merker"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Fullført"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Merk de listede personene og familiene som Fullført"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Ignorer"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Merk personer og familier for å ignorere dem"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Beskjær"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Merk de listede personene og familiene for å beskjære (utelate) dem fra "
"kontrollen"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Søkekvote "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Minste antall linjer som vises. Søket stopper når så mange problemer er "
"funnet"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Dybde per runde"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Hvor mange generasjoner etterkommere som kontrolleres før det går én "
"generasjon aner opp"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Pause i utvidelse av søket"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Hvor mange ekstra runder det ventes etter kontroll av en ane før anens "
"etterkommere kontrolleres"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Merke for Fullført"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Ferdig. Skjul objektet, og fortsett søket gjennom det"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Merke for Ignorer"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Lagt til side inntil videre. Skjul objektet, og fortsett søket gjennom det"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Merke for Beskjær"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Blindvei. Skjul objektet, og stopp søket gjennom det"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Vis foreslåtte 👣 neste trinn"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "Vis veiledningstrinnene og 👣 forslagene. Slå av for en kortere liste"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Gjennomgå (åpne redigering)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Merk som Fullført"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Merk for å ignorere"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Merk for å beskjære"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Merk som %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Den gjeldende slektstre-databasen inneholder ingen personer.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Neste trinn:\n"
" Legg til en familie og en person i den familien:\n"
"  • En familie kan legges til via menyen \"Opprett\"\n"
"  • En person kan legges til ved å trykke på \"+\" (pluss) i ektefellepanelene (\"Far/partner1\" eller \"Mor/partner2\") eller i fanen \"Barn\".\n"
"\n"
"Eller importer personer fra en ekstern fil:\n"
"  • En ekstern fil kan brukes til å fylle slektstreet via \"Importer...\" i menyen \"Slektstrær\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Ingen person er valgt som sentral \"Startperson\".\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Neste trinn:\n"
"  •  Velg ikonet for visningen Personer i sidepanelet til Navigatoren.\n"
"  •  Velg noen for å gjøre vedkommende til \"Aktiv person\".\n"
"  •  Velg \"Gjør til startperson\" fra menyen Rediger eller fra hurtigmenyen (høyreklikk).\n"
"\n"
" Dette gjør vedkommende til sentral \"Startperson\"."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Dobbeltklikk på farget tekst for å redigere detaljer"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "sentral Startperson"

