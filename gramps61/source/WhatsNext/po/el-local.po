#, python-format
msgid "%(str1)s: %(str2)s"
msgstr "%(str1)s: %(str2)s"

#: WhatsNext.py:2204
msgid "A partner relationship exists but the spouse is missing"
msgstr "Υπάρχει σχέση συντρόφων αλλά λείπει ο σύζυγος"

#: WhatsNext.py:2216
msgid "Father missing from the parent family"
msgstr "Λείπει ο πατέρας από την οικογένεια γονέων"

#: WhatsNext.py:2227
msgid "Mother missing from the parent family"
msgstr "Λείπει η μητέρα από την οικογένεια γονέων"

#: WhatsNext.py:2237
msgid "Parent family is unknown."
msgstr "Η οικογένεια γονέων είναι άγνωστη."

#: WhatsNext.py:2254
#, python-format
msgid ": %s\n"
msgstr ": %s\n"
