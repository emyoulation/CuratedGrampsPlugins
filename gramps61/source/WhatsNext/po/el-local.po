msgid "first name unknown"
msgstr "άγνωστο όνομα"

#: WhatsNext.py:1994
msgid "surname unknown"
msgstr "άγνωστο επώνυμο"

#: WhatsNext.py:2000
msgid "Birth event missing"
msgstr "Λείπει το συμβάν Γέννησης"

#: WhatsNext.py:2011
msgid "Death event missing"
msgstr "Λείπει το συμβάν Θανάτου"

#: WhatsNext.py:2129
msgid "marriage event missing"
msgstr "λείπει ο γάμος"

#: WhatsNext.py:2133
msgid "relationship type unknown"
msgstr "άγνωστος τύπος σχέσης"

#: WhatsNext.py:2167
msgid "date unknown"
msgstr "άγνωστη ημερομηνία"

#: WhatsNext.py:2170
msgid "date is text only"
msgstr "η ημερομηνία είναι μόνο κείμενο"

#: WhatsNext.py:2175
msgid "date inexact"
msgstr "ανακριβής ημερομηνία"

#: WhatsNext.py:2178
msgid "date incomplete"
msgstr "ημερομηνία ανολοκλήρωτη"

#: WhatsNext.py:2181
msgid "place unknown for the Event"
msgstr "άγνωστος τόπος του Συμβάντος"

