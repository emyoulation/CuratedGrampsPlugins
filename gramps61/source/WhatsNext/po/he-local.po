#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "מה הלאה"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "גרמפלט להצעות פריטים למחקר"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "מה הלאה?"

#: WhatsNext.py:129
msgid "Help"
msgstr "עזרה"

#: WhatsNext.py:206
msgid "People"
msgstr "אנשים"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "שם פרטי לא ידוע"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "דיווח על אדם ללא שם פרטי"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "שם משפחה לא ידוע"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "דיווח על אדם ללא שם משפחה"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "חסר אירוע לידה"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "דיווח על אדם ללא אירוע לידה"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "תאריך ומקום לידה"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "בדיקת התאריך והמקום של אירוע הלידה"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "חסר אירוע פטירה"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"דיווח על אדם ללא אירוע פטירה, כאשר Gramps מסיק מהתאריכים של האדם ושל קרוביו "
"שהאדם אינו בחיים עוד"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "תאריך ומקום פטירה"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "בדיקת התאריך והמקום של אירוע הפטירה"

#: WhatsNext.py:241
msgid "Families"
msgstr "משפחות"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "סוג קשר לא ידוע"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "דיווח על משפחה שסוג הקשר שלה \"לא ידוע\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "חסר אירוע נישואין"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "דיווח על משפחה מסוג \"נישואין\" ללא אירוע נישואין"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "תאריך ומקום הנישואין"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "בדיקת התאריך והמקום של אירוע הנישואין"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "תאריך ומקום הגירושין"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "בדיקת התאריך והמקום של אירוע הגירושין"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "קשרי־קרבה"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "חסרה משפחת הורים"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "רשימת כל אדם שאין לו משפחת הורים"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "חסר בן זוג"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "דיווח על משפחה עם בן זוג אחד בלבד"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "חסר אב"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "דיווח על אדם שבמשפחת הוריו אין אב"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "חסרה אם"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "דיווח על אדם שבמשפחת הוריו אין אם"

#: WhatsNext.py:291
msgid "Events"
msgstr "אירועים"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "תאריך לא ידוע"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "דיווח על אירוע ללא תאריך"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "התאריך הוא טקסט בלבד"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "דיווח על תאריך ש-Gramps לא הצליח לקרוא כתאריך"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "תאריך לא מדויק"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr "דיווח על טווח, תקופה, או תאריך עם \"לפני\", \"אחרי\", \"מקורב\", \"משוער\" או \"מחושב\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "תאריך חלקי"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "דיווח על תאריך בודד ללא יום או חודש"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "מקום לא ידוע"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "דיווח על אירוע ללא מקום"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "יש להזין את השם החסר בחלון עריכת אנשים."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "יש להוסיף דרך לשונית האירועים בחלון עריכת אנשים."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"יש לפתוח את האירוע בלשונית האירועים בחלון עריכת אנשים ולהשלים את התאריך "
"והמקום שלו."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"יש לפתוח את האירוע בלשונית האירועים בחלון עריכת משפחה ולהשלים את התאריך "
"והמקום שלו."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr "יש להוסיף אירוע נישואין בלשונית האירועים בחלון עריכת משפחה."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "יש לבחור את \"סוג\" הקשר בחלון עריכת משפחה."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "יש להוסיף את בן הזוג החסר בחלון עריכת משפחה."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "יש להוסיף את האב בחלון עריכת משפחה של משפחת ההורים."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "יש להוסיף את האם בחלון עריכת משפחה של משפחת ההורים."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"במצג קשרי־קרבה, יש לבחור \"הוספת הורים חדשים...\" או \"הוספת הורים "
"קיימים...\" מתפריט עריכה."

#: WhatsNext.py:400
msgid "Completed"
msgstr "הושלם"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "הוזנח"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "נגזם"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ עדיין לא נטען מסד נתונים מקומי של אילן יוחסין.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 הצעדים הבאים:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  מתפריט \"אילנות יוחסין\","

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " יש להשתמש באפשרות \"ניהול אילנות יוחסין...\" כדי"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " ליצור מסד נתונים חדש של אילן (או לבחור אחד קיים).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  יש ללחוץ על הכפתור \"טעינת אילן־יוחסין\" כדי להתחיל"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" לעבוד עם אילן היוחסין שנבחר.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"כדי להשתמש בגיבוי מ-Gramps, או בקובץ GEDCOM מכלי גנאלוגי אחר, יש לבחור \"ייבוא...\" בתפריט \"אילנות יוחסין\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"כדי להשתמש בגיבוי מ-Gramps, או בקובץ GEDCOM מכלי גנאלוגי אחר, יש ליצור ולטעון תחילה אילן חדש וריק. לאחר מכן יש לבחור \"ייבוא...\" בתפריט \"אילנות יוחסין\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr "יש להשתמש ב\"תיצור...\" בתפריט \"מצג\" כדי לשנות את אפשרויות הגרמפלט."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "ניהול תגים"

#: WhatsNext.py:719
msgid "Complete"
msgstr "מושלם"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "תיוג האנשים והמשפחות הרשומים כהושלמו"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "התעלמות"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "תיוג אנשים ומשפחות להתעלמות"

#: WhatsNext.py:739
msgid "Prune"
msgstr "גיזום"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr "תיוג האנשים והמשפחות הרשומים לגיזום (החרגה) מהבדיקה"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "מכסת חיפוש "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr "המספר המזערי של שורות להצגה. החיפוש נעצר כאשר נמצאת כמות כזו של בעיות"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "עומק לכל סבב"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr "כמה דורות של צאצאים לבדוק לפני שעולים דור נוסף של אבות קדמונים"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "השהיית הרחבת החיפוש"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"כמה סבבים נוספים להמתין לאחר בדיקת אב קדמון לפני בדיקת הצאצאים של אותו אב "
"קדמון"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "תג הושלם"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "הושלם. הסתרת הפריט, והמשך החיפוש דרכו"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "תג התעלמות"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "הונח בצד לעת עתה. הסתרת הפריט, והמשך החיפוש דרכו"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "תג גיזום"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "מבוי סתום. הסתרת הפריט, והפסקת החיפוש דרכו"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "הצגת 👣 הצעדים הבאים המוצעים"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "הצגת צעדי ההדרכה וה-👣 הצעות. יש לכבות לרשימה קצרה יותר"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_סקירה (פתיחת העורך)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "תיוג כהושלם"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "תיוג להתעלמות"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "תיוג לגיזום"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "תיוג כ־%s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ מסד הנתונים של האילן הנוכחי אינו מכיל אנשים.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 הצעדים הבאים:\n"
" יש להוסיף משפחה ואדם במשפחה זו:\n"
"  • ניתן להוסיף משפחה דרך תפריט \"הוספה\"\n"
"  • ניתן להוסיף אדם בלחיצה על \"+\" (פלוס) בלוחות בני הזוג (\"אב/הורה1\" או \"אם/הורה2\") או בלשונית \"צאצאים\".\n"
"\n"
"או לייבא אנשים מקובץ חיצוני:\n"
"  • ניתן להשתמש בקובץ חיצוני כדי למלא את האילן דרך \"ייבוא...\" בתפריט \"אילנות יוחסין\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ לא נבחר אף אדם כ\"אדם הבית\" המרכזי.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 הצעדים הבאים:\n"
"  •  יש לבחור בסמל מצג האנשים בסרגל הצד של הנווט.\n"
"  •  יש לבחור מישהו כדי להפוך אותו ל\"אדם הפעיל\".\n"
"  •  יש לבחור \"הגדרת אדם ה'בית'\" מתפריט עריכה או מתפריט ההקשר (לחיצה ימנית).\n"
"\n"
" כך הוא מוגדר כ\"אדם הבית\" המרכזי."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "לחיצה כפולה על טקסט צבעוני לעריכת הפרטים"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "אדם הבית המרכזי"

