msgid "Birth event missing"
msgstr "חסר אירוע לידה"

#: WhatsNext.py:2011
msgid "Death event missing"
msgstr "חסר אירוע פטירה"

#: WhatsNext.py:2129
msgid "marriage event missing"
msgstr "חסר אירוע נישואין"

#: WhatsNext.py:2133
msgid "relationship type unknown"
msgstr "סוג הקשר לא ידוע"

#: WhatsNext.py:2167
msgid "date unknown"
msgstr "תאריך לא ידוע"

#: WhatsNext.py:2170
msgid "date is text only"
msgstr "התאריך הוא טקסט בלבד"

#: WhatsNext.py:2175
msgid "date inexact"
msgstr "התאריך לא מדויק"

#: WhatsNext.py:2178
