#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Gode forslag"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplet som giver forslag til emner til udforskning"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Næste opgave?"

#: WhatsNext.py:129
msgid "Help"
msgstr "_Hjælp"

#: WhatsNext.py:206
msgid "People"
msgstr "Personer"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Ukendt fornavn"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Rapportér en person uden fornavn"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Ukendt efternavn"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Rapportér en person uden efternavn"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Manglende Fødsel-begivenhed"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Rapportér en person uden Fødsel-begivenhed"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Fødselsdato og -sted"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Kontrollér dato og sted for Fødsel-begivenheden"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Manglende Død-begivenhed"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Rapportér en person uden Død-begivenhed, når Gramps ud fra personens og "
"slægtninges datoer vurderer, at personen ikke længere lever"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Dødsdato og -sted"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Kontrollér dato og sted for Død-begivenheden"

#: WhatsNext.py:241
msgid "Families"
msgstr "Familier"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Ukendt type af forhold"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Rapportér en familie med typen af forhold \"Ukendt\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Manglende Ægteskab-begivenhed"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Rapportér en familie af typen \"Gift\" uden Ægteskab-begivenhed"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Vielsesdato og -sted"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Kontrollér dato og sted for Ægteskab-begivenheden"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Skilsmissedato og -sted"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Kontrollér dato og sted for Skilsmisse-begivenheden"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Slægtsforhold"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Manglende forældrefamilie"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Vis hver person, der ikke har en forældrefamilie"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Manglende partner"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Rapportér en familie med kun én partner"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Manglende fader"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Rapportér en person, hvis forældrefamilie ikke har nogen fader"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Manglende moder"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Rapportér en person, hvis forældrefamilie ikke har nogen moder"

#: WhatsNext.py:291
msgid "Events"
msgstr "Begivenheder"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Ukendt dato"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Rapportér en begivenhed uden dato"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Dato er kun tekst"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Rapportér en dato, som Gramps ikke kunne læse som en dato"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Upræcis dato"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Rapportér et interval, et tidsrum eller en dato med \"før\", \"efter\", "
"\"omkring\", \"anslået\" eller \"beregnet\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Ufuldstændig dato"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Rapportér en enkelt dato uden dag eller måned"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Ukendt sted"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Rapportér en begivenhed uden sted"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Indtast det manglende navn i dialogen Redigér person."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Tilføj via fanen Begivenheder i dialogen Redigér person."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Åbn begivenheden på fanen Begivenheder i dialogen Redigér person, og udfyld "
"dens dato og sted."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Åbn begivenheden på fanen Begivenheder i dialogen Redigér familie, og udfyld"
" dens dato og sted."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Tilføj en Ægteskab-begivenhed på fanen Begivenheder i dialogen Redigér "
"familie."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Vælg forholdets \"Type\" i dialogen Redigér familie."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Tilføj den manglende partner i dialogen Redigér familie."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Tilføj faderen i dialogen Redigér familie for forældrefamilien."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Tilføj moderen i dialogen Redigér familie for forældrefamilien."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"I visningen Slægtsforhold vælges \"Tilføj nye forældre ...\" eller \"Tilføj "
"et eksisterende par forældre ...\" i menuen Redigér."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Færdiggjort"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Ignoreret"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Beskåret"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Der er endnu ikke indlæst en lokal slægtsbog-database.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Næste trin:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  I menuen \"Slægtsbøger\""

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " bruges \"Arbejd med slægtsbøger ...\" til at"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " oprette en ny slægtsbog-database (eller vælge en eksisterende).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Klik på knappen \"Indlæs slægtsbog\" for at begynde"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" at arbejde med den valgte slægtsbog.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"For at bruge en sikkerhedskopi fra Gramps eller en GEDCOM-fil fra et andet slægtsprogram skal du vælge \"Importér ...\" i menuen \"Slægtsbøger\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"For at bruge en sikkerhedskopi fra Gramps eller en GEDCOM-fil fra et andet slægtsprogram skal du først oprette og indlæse en ny, tom slægtsbog. Vælg derefter \"Importér ...\" i menuen \"Slægtsbøger\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Brug \"Konfigurér...\" i menuen \"Vis\" til at ændre Gramplettens "
"indstillinger."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Organisér mærkater"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Fuldstændig"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Mærk de viste personer og familier som Fuldført"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Ignorér"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Mærk personer og familier som Ignorér"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Beskær"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr "Mærk de viste personer og familier som Beskær (udelad) fra kontrollen"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Søgekvote "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Det mindste antal linjer, der skal vises. Søgningen stopper, når så mange "
"problemer er fundet"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Dybde pr. runde"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Hvor mange generationer af efterkommere der kontrolleres, før der gås én "
"generation af aner op"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Pause i udvidelse af søgning"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Hvor mange ekstra runder der ventes efter kontrol af en ane, før anens "
"efterkommere kontrolleres"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Mærkat for Fuldført"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Færdig. Skjul objektet, og fortsæt søgningen gennem det"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Mærkat for Ignorér"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Lagt til side indtil videre. Skjul objektet, og fortsæt søgningen gennem det"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Mærkat for Beskær"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Blindgyde. Skjul objektet, og stop søgningen gennem det"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Vis foreslåede 👣 næste trin"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "Vis vejledningstrinene og 👣 forslagene. Slå fra for en kortere liste"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Gennemse (åbn redigering)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Mærk som Fuldført"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Mærk som Ignorér"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Mærk som Beskær"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Mærk som %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Den aktuelle slægtsbog-database indeholder ingen personer.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Næste trin:\n"
" Tilføj en familie og en person i den familie:\n"
"  • En familie kan tilføjes via menuen \"Tilføj\"\n"
"  • En person kan tilføjes ved at trykke på \"+\" (plus) i ægtefællepanelerne (\"Fader/partner1\" eller \"Moder/partner2\") eller på fanen \"Børn\".\n"
"\n"
"Eller importér personer fra en ekstern fil:\n"
"  • En ekstern fil kan bruges til at fylde slægtsbogen via \"Importér ...\" i menuen \"Slægtsbøger\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Ingen person er valgt som central \"Proband\".\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Næste trin:\n"
"  •  Vælg ikonet for visningen Personer i Navigatorens sidepanel.\n"
"  •  Vælg en person for at gøre vedkommende til \"Aktiv person\".\n"
"  •  Vælg \"Gør til proband\" i menuen Redigér eller i genvejsmenuen (højreklik).\n"
"\n"
" Det gør vedkommende til central \"Proband\"."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Dobbeltklik på farvet tekst for at redigere detaljer"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "central Proband"

