msgid "Help"
msgstr "Cab_hair"

#: WhatsNext.py:206
msgid "People"
msgstr "Daoine"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Céadainm anaithnid"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Tuairiscigh duine gan chéadainm"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Sloinne anaithnid"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Tuairiscigh duine gan sloinne"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Ócáid Bhreithe ar iarraidh"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Tuairiscigh duine gan ócáid Bhreithe"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Dáta agus áit bhreithe"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Seiceáil dáta agus áit na hócáide Breithe"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Ócáid Báis ar iarraidh"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Tuairiscigh duine gan ócáid Báis, nuair a mheasann Gramps ó dhátaí an duine "
"agus a ghaolta nach bhfuil an duine beo a thuilleadh"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Dáta agus áit bháis"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Seiceáil dáta agus áit na hócáide Báis"

#: WhatsNext.py:241
msgid "Families"
msgstr "Teaghlaigh"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Cineál caidrimh anaithnid"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Tuairiscigh teaghlach a bhfuil an cineál caidrimh \"Anaithnid\" aige"

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Ócáid Phósta ar iarraidh"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Tuairiscigh teaghlach den chineál \"Pósta\" gan ócáid Phósta"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Dáta agus áit an phósta"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Seiceáil dáta agus áit na hócáide Pósta"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Dáta agus áit an cholscartha"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Seiceáil dáta agus áit na hócáide Colscartha"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Caidrimh"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Teaghlach tuismitheoirí ar iarraidh"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Liostaigh gach duine nach bhfuil teaghlach tuismitheoirí aige"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Comhpháirtí ar iarraidh"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Tuairiscigh teaghlach nach bhfuil ach comhpháirtí amháin ann"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Athair ar iarraidh"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Tuairiscigh duine nach bhfuil athair i dteaghlach a thuismitheoirí"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Máthair ar iarraidh"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Tuairiscigh duine nach bhfuil máthair i dteaghlach a thuismitheoirí"

#: WhatsNext.py:291
msgid "Events"
msgstr "Ócáidí"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Dáta anaithnid"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Tuairiscigh ócáid gan dáta"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Téacs amháin atá sa dáta"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Tuairiscigh dáta nárbh fhéidir le Gramps a léamh mar dháta"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Dáta neamhbheacht"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Tuairiscigh raon, tréimhse, nó dáta le \"roimh\", \"tar éis\", \"thart ar\","
" \"measta\" nó \"ríofa\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Dáta neamhiomlán"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Tuairiscigh dáta aonair gan a lá ná a mhí"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Áit anaithnid"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Tuairiscigh ócáid gan áit"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Cuir isteach an t-ainm atá ar iarraidh sa dialóg Cuir Duine in eagar."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Cuir leis trí chluaisín na nÓcáidí sa dialóg Cuir Duine in eagar."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Oscail an ócáid ar chluaisín na nÓcáidí sa dialóg Cuir Duine in eagar, agus "
"comhlánaigh a dáta agus a háit."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Oscail an ócáid ar chluaisín na nÓcáidí sa dialóg Cuir an Teaghlach in "
"eagar, agus comhlánaigh a dáta agus a háit."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Cuir ócáid Phósta leis ar chluaisín na nÓcáidí sa dialóg Cuir an Teaghlach "
"in eagar."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Roghnaigh \"Cineál\" an chaidrimh sa dialóg Cuir an Teaghlach in eagar."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr ""
"Cuir an comhpháirtí atá ar iarraidh leis sa dialóg Cuir an Teaghlach in "
"eagar."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr ""
"Cuir an t-athair leis sa dialóg Cuir an Teaghlach in eagar do theaghlach na "
"dtuismitheoirí."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr ""
"Cuir an mháthair leis sa dialóg Cuir an Teaghlach in eagar do theaghlach na "
"dtuismitheoirí."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"San amharc Caidrimh, roghnaigh \"Cuir Tuismitheoirí Nua leis...\" nó \"Cuir "
"Tuismitheoirí Reatha Leis...\" ón roghchlár Eagar."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Críochnaithe"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Neamhairdithe"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Bearrtha"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Níl bunachar sonraí logánta Crainn Ghinealaigh lódáilte fós.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Na Chéad Chéimeanna Eile:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  Ón roghchlár \"Crainn Ghinealaigh\","

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " úsáid an rogha \"Bainistigh Crainn Ghinealaigh...\" chun"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr ""
" bunachar sonraí Crainn Nua a chruthú (nó ceann atá ann cheana a roghnú).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Cliceáil an cnaipe \"Lódáil Crann Ginealaigh\" chun tosú"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" ag obair leis an gcrann ginealaigh roghnaithe.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Chun cúltaca ó Gramps, nó comhad GEDCOM ó uirlis ghinealaigh eile, a úsáid, roghnaigh \"Allmhairiú...\" sa roghchlár \"Crainn Ghinealaigh\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Chun cúltaca ó Gramps, nó comhad GEDCOM ó uirlis ghinealaigh eile, a úsáid, cruthaigh agus lódáil crann nua folamh ar dtús. Ansin roghnaigh \"Allmhairiú...\" sa roghchlár \"Crainn Ghinealaigh\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Úsáid \"Cumraigh...\" sa roghchlár \"View\" chun roghanna an Gramplet a "
"athrú."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Clibeanna a eagrú"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Comhlánaigh"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Clibeáil na Daoine agus na Teaghlaigh liostaithe mar Críochnaithe"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Déan neamhaird de"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Clibeáil chun neamhaird a dhéanamh de Dhaoine agus de Theaghlaigh"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Bearr"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Clibeáil chun na Daoine agus na Teaghlaigh liostaithe a bhearradh (a "
"eisiamh) ón tástáil"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Cuóta Cuardaigh "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"An líon línte is lú le taispeáint. Stopann an cuardach nuair a aimsítear an "
"méid sin fadhbanna"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Doimhneacht in aghaidh an lúib"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Cé mhéad glúin de shliocht le seiceáil sula dtéitear suas glúin eile de "
"shinsir"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Cuir leathnú an chuardaigh ar sos"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Cé mhéad babhta breise le fanacht tar éis sinsear a sheiceáil sula "
"seiceáiltear sliocht an tsinsir sin"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Clib Chríochnaithe"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Críochnaithe. Folaigh an réad, agus lean ar aghaidh ag cuardach tríd"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Clib Neamhairde"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Curtha i leataobh go fóill. Folaigh an réad, agus lean ar aghaidh ag "
"cuardach tríd"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Clib Bhearrtha"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Bealach caoch. Folaigh an réad, agus stop ag cuardach tríd"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Taispeáin na 👣 Chéad Chéimeanna Eile molta"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Taispeáin na céimeanna treorach agus na 👣 moltaí. Múch é le haghaidh liosta "
"níos giorra"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Athbhreithnigh (oscail an t-eagarthóir)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Clibeáil mar Críochnaithe"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Clibeáil le Neamhaird"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Clibeáil le Bearradh"

