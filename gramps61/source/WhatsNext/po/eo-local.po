#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Kio nova"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplet por sugesti elementojn serĉotajn"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Kio nova?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Helpo"

#: WhatsNext.py:206
msgid "People"
msgstr "Personoj"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Nekonata antaŭnomo"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Raporti personon sen antaŭnomo"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Nekonata familinomo"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Raporti personon sen familinomo"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Mankas evento Naskiĝo"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Raporti personon sen evento Naskiĝo"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Naskiĝdato kaj -loko"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Kontroli la daton kaj lokon de la evento Naskiĝo"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Mankas evento Morto"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Raporti personon sen evento Morto, kiam Gramps juĝas laŭ la datoj de la "
"persono kaj de parencoj, ke la persono ne plu vivas"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Mortodato kaj -loko"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Kontroli la daton kaj lokon de la evento Morto"

#: WhatsNext.py:241
msgid "Families"
msgstr "Familioj"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Nekonata tipo de rilato"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Raporti familion kun la tipo de rilato \"Nekonata\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Mankas evento Geedziĝo"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Raporti familion de la tipo \"Geedzo\" sen evento Geedziĝo"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Geedziĝdato kaj -loko"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Kontroli la daton kaj lokon de la evento Geedziĝo"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Divorcodato kaj -loko"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Kontroli la daton kaj lokon de la evento Divorco"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Parencecoj"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Mankas gepatra familio"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Listigi ĉiun personon, kiu ne havas gepatran familion"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Mankas partnero"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Raporti familion kun nur unu partnero"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Mankas patro"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Raporti personon, kies gepatra familio ne havas patron"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Mankas patrino"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Raporti personon, kies gepatra familio ne havas patrinon"

#: WhatsNext.py:291
msgid "Events"
msgstr "Eventoj"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Nekonata dato"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Raporti eventon sen dato"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Dato estas nur teksto"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Raporti daton, kiun Gramps ne povis legi kiel daton"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Neekzakta dato"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Raporti intervalon, periodon aŭ daton kun \"antaŭ\", \"post\", \"ĉirkaŭ\", "
"\"taksata\" aŭ \"kalkulita\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Nekompleta dato"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Raporti unuopan daton sen tago aŭ monato"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Nekonata loko"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Raporti eventon sen loko"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Enigu la mankantan nomon en la dialogo Redaktu Personon."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Aldonu per la langeto Eventoj de la dialogo Redaktu Personon."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Malfermu la eventon en la langeto Eventoj de la dialogo Redaktu Personon, "
"kaj kompletigu ĝian daton kaj lokon."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Malfermu la eventon en la langeto Eventoj de la dialogo Redaktu familion, "
"kaj kompletigu ĝian daton kaj lokon."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Aldonu eventon Geedziĝo en la langeto Eventoj de la dialogo Redaktu "
"familion."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Elektu la \"Tipo\" de rilato en la dialogo Redaktu familion."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Aldonu la mankantan partneron en la dialogo Redaktu familion."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr ""
"Aldonu la patron en la dialogo Redaktu familion de la gepatra familio."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr ""
"Aldonu la patrinon en la dialogo Redaktu familion de la gepatra familio."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"En la vido Parencecoj, elektu \"Aldonu novajn gepatrojn...\" aŭ \"Aldonu "
"ekzistantajn gepatrojn...\" el la menuo Redaktu."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Purigita"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Ignorita"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Pritondita"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Loka genealogia datumbazo ankoraŭ ne estas ŝargita.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Sekvaj paŝoj:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  El la menuo \"Genealogiaj arboj\","

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " uzu la opcion \"Administru genealogiajn arbojn...\" por"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " krei novan arban datumbazon (aŭ por elekti ekzistantan).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Alklaku la butonon \"Ŝargu genealogian arbon\" por komenci"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" labori kun la elektita genealogia arbo.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Por uzi savkopion el Gramps, aŭ GEDCOM-dosieron el alia genealogia ilo, elektu \"Importu...\" en la menuo \"Genealogiaj arboj\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Por uzi savkopion el Gramps, aŭ GEDCOM-dosieron el alia genealogia ilo, unue kreu kaj ŝargu novan, malplenan arbon. Poste elektu \"Importu...\" en la menuo \"Genealogiaj arboj\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Uzu \"Agordu...\" en la menuo \"Montru\" por ŝanĝi la opciojn de la "
"kromprogrameto."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Organizu etikedojn"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Kompleta"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Etikedi la listigitajn personojn kaj familiojn kiel Kompletigitaj"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Ignori"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Etikedi por ignori personojn kaj familiojn"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Pritondi"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Etikedi por pritondi (ekskludi) la listigitajn personojn kaj familiojn el la"
" kontrolado"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Serĉa kvoto "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"La plej malgranda nombro de linioj por montri. La serĉo ĉesas, kiam tiom da "
"problemoj estas trovitaj"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Profundo por ciklo"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Kiom da generacioj de idoj kontroli antaŭ ol supreniri unu plian generacion "
"de prauloj"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Paŭzigi serĉan vastigon"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Kiom da kromaj rondoj atendi post kontrolo de praulo antaŭ ol kontroli la "
"idojn de tiu praulo"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Etikedo Kompletigita"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Finita. Kaŝi la objekton, kaj daŭre serĉi tra ĝi"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Etikedo Ignorita"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "Flankenmetita nuntempe. Kaŝi la objekton, kaj daŭre serĉi tra ĝi"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Etikedo Pritondita"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Senelirejo. Kaŝi la objekton, kaj ĉesi serĉi tra ĝi"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Montri la proponitajn 👣 sekvajn paŝojn"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Montri la gvidajn paŝojn kaj la 👣 proponojn. Malŝaltu por pli mallonga listo"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Revizii (malfermi redaktilon)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Etikedi kiel Kompletigita"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Etikedi por ignori"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Etikedi por pritondi"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Etikedi kiel %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ La nuna arba datumbazo enhavas neniun personon.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Sekvaj paŝoj:\n"
" Aldonu familion kaj personon en tiu familio:\n"
"  • Familio povas esti aldonita per la menuo \"Aldonu\"\n"
"  • Persono povas esti aldonita per premo de \"+\" (plus) en la paneloj de geedzoj (\"Patro/partnero1\" aŭ \"Patrino/partnero2\") aŭ en la langeto \"Gefiloj\".\n"
"\n"
"Aŭ importu personojn el ekstera dosiero:\n"
"  • Ekstera dosiero povas plenigi la arbon per \"Importu...\" en la menuo \"Genealogiaj arboj\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Neniu persono estas elektita kiel centra \"Defaŭlta persono\".\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Sekvaj paŝoj:\n"
"  •  Elektu la piktogramon de la vido Personoj en la flanka breto de la Navigilo.\n"
"  •  Elektu iun por fari ĝin la \"Aktiva persono\".\n"
"  •  Elektu \"Agordu la hejmpersonon\" el la menuo Redaktu aŭ el la kunteksta menuo (dekstra klako).\n"
"\n"
" Tio igas ĝin la centra \"Defaŭlta persono\"."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Duoble alklaku koloran tekston por redakti detalojn"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "centra Defaŭlta persono"

