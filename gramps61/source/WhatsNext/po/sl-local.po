#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Kaj sledi?"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Pripomoček za prikaz namigov, kaj bi bilo dobro raziskovati"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Kaj sledi?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Pomoč"

#: WhatsNext.py:206
msgid "People"
msgstr "Osebe"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Neznano ime"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Sporoči osebo brez imena"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Neznan priimek"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Sporoči osebo brez priimka"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Manjka dogodek Rojstvo"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Sporoči osebo brez dogodka Rojstvo"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Datum in kraj rojstva"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Preveri datum in kraj dogodka Rojstvo"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Manjka dogodek Smrt"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Sporoči osebo brez dogodka Smrt, kadar Gramps po datumih osebe in sorodnikov"
" presodi, da oseba ni več živa"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Datum in kraj smrti"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Preveri datum in kraj dogodka Smrt"

#: WhatsNext.py:241
msgid "Families"
msgstr "Družine"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Neznana vrsta razmerja"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Sporoči družino z vrsto razmerja \"Neznano\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Manjka dogodek Poroka"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Sporoči družino vrste \"Poročen\" brez dogodka Poroka"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Datum in kraj poroke"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Preveri datum in kraj dogodka Poroka"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Datum in kraj ločitve"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Preveri datum in kraj dogodka Ločitev"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Sorodstvo"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Manjka družina staršev"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Navedi vsako osebo, ki nima družine staršev"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Manjka partner"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Sporoči družino s samo enim partnerjem"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Manjka oče"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Sporoči osebo, katere družina staršev nima očeta"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Manjka mati"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Sporoči osebo, katere družina staršev nima matere"

#: WhatsNext.py:291
msgid "Events"
msgstr "Dogodki"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Neznan datum"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Sporoči dogodek brez datuma"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Datum je samo besedilo"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Sporoči datum, ki ga Gramps ni mogel prebrati kot datum"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Nenatančen datum"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Sporoči razpon, obdobje ali datum s \"pred\", \"po\", \"okrog\", \"po "
"oceni\" ali \"po izračunu\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Nepopoln datum"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Sporoči posamičen datum brez dneva ali meseca"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Neznan kraj"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Sporoči dogodek brez kraja"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Vnesite manjkajoče ime v pogovornem oknu Uredi osebo."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Dodajte prek zavihka Dogodki v pogovornem oknu Uredi osebo."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Odprite dogodek na zavihku Dogodki v pogovornem oknu Uredi osebo in "
"dopolnite njegov datum in kraj."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Odprite dogodek na zavihku Dogodki v pogovornem oknu Uredi družino in "
"dopolnite njegov datum in kraj."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Dodajte dogodek Poroka na zavihku Dogodki v pogovornem oknu Uredi družino."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Izberite \"Vrsto\" razmerja v pogovornem oknu Uredi družino."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Dodajte manjkajočega partnerja v pogovornem oknu Uredi družino."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Dodajte očeta v pogovornem oknu Uredi družino za družino staršev."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Dodajte mater v pogovornem oknu Uredi družino za družino staršev."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"V pogledu Sorodstvo v meniju Uredi izberite \"Dodaj nove starše ...\" ali "
"\"Dodaj obstoječe starše ...\"."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Končan"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Prezrto"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Obrezano"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Lokalna zbirka podatkov rodovnika še ni naložena.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Naslednji koraki:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  V meniju \"Rodovniki\""

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " uporabite možnost \"Uredi rodovnike ...\", da"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " ustvarite novo zbirko podatkov rodovnika (ali izberete obstoječo).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Kliknite gumb \"Naloži rodovnik\", da začnete"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" delati z izbranim rodovnikom.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Če želite uporabiti varnostno kopijo iz Grampsa ali datoteko GEDCOM iz drugega rodoslovnega programa, v meniju \"Rodovniki\" izberite \"Uvozi ...\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Če želite uporabiti varnostno kopijo iz Grampsa ali datoteko GEDCOM iz drugega rodoslovnega programa, najprej ustvarite in naložite nov, prazen rodovnik. Nato v meniju \"Rodovniki\" izberite \"Uvozi ...\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Za spremembo možnosti pripomočka uporabite \"Nastavi ...\" v meniju "
"\"Pogled\"."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Uredi oznake"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Končano"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Označi navedene osebe in družine kot Dokončano"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Prezri"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Oznaka za prezrtje oseb in družin"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Obreži"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Oznaka za obrezovanje (izključitev) navedenih oseb in družin iz preverjanja"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Kvota iskanja "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Najmanjše število vrstic za prikaz. Iskanje se ustavi, ko je najdenih toliko"
" težav"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Globina na krog"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr "Koliko rodov potomcev preveriti, preden se dvigne še en rod prednikov"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Začasno ustavi širjenje iskanja"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Koliko dodatnih krogov počakati po preverjanju prednika, preden se preverijo"
" potomci tega prednika"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Oznaka Dokončano"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Končano. Skrij predmet in nadaljuj iskanje skozenj"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Oznaka Prezrto"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "Zaenkrat odloženo. Skrij predmet in nadaljuj iskanje skozenj"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Oznaka Obrezano"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Slepa ulica. Skrij predmet in ustavi iskanje skozenj"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Prikaži predlagane 👣 naslednje korake"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "Prikaži korake vodnika in 👣 predloge. Izklopite za krajši seznam"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Preglej (odpri urejevalnik)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Označi kot Dokončano"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Označi za prezrtje"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Označi za obrezovanje"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Označi kot %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Trenutna zbirka podatkov rodovnika ne vsebuje oseb.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Naslednji koraki:\n"
" Dodajte družino in osebo v tej družini:\n"
"  • Družino lahko dodate prek menija \"Dodaj\"\n"
"  • Osebo lahko dodate s pritiskom na \"+\" (plus) na ploščah zakoncev (\"Oče\" ali \"Mati\") ali na zavihku \"Otroci\".\n"
"\n"
"Ali uvozite osebe iz zunanje datoteke:\n"
"  • Zunanjo datoteko lahko uporabite za polnjenje rodovnika prek \"Uvozi ...\" v meniju \"Rodovniki\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Nobena oseba ni izbrana za osrednjo \"Privzeto osebo\".\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Naslednji koraki:\n"
"  •  Izberite ikono pogleda Osebe v stranski vrstici Krmarja.\n"
"  •  Izberite nekoga, da postane \"Dejavna oseba\".\n"
"  •  V meniju Uredi ali v priročnem meniju (desni klik) izberite \"Nastavi izhodiščno osebo\".\n"
"\n"
" Tako postane osrednja \"Privzeta oseba\"."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Dvokliknite obarvano besedilo za urejanje podrobnosti"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "osrednja Privzeta oseba"

