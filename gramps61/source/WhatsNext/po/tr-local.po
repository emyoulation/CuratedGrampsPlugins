#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Sıradaki ne"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Araştırma için ögeleri öneren Gramplet"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Sıradaki Ne?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Yardım"

#: WhatsNext.py:206
msgid "People"
msgstr "Kişiler"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Bilinmeyen ad"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Adı olmayan kişiyi bildir"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Bilinmeyen soyadı"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Soyadı olmayan kişiyi bildir"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Doğum etkinliği eksik"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Doğum etkinliği olmayan kişiyi bildir"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Doğum tarihi ve yeri"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Doğum etkinliğinin tarihini ve yerini denetle"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Ölüm etkinliği eksik"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Gramps kişinin ve akrabalarının tarihlerinden kişinin artık hayatta "
"olmadığına karar verdiğinde, Ölüm etkinliği olmayan kişiyi bildir"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Ölüm tarihi ve yeri"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Ölüm etkinliğinin tarihini ve yerini denetle"

#: WhatsNext.py:241
msgid "Families"
msgstr "Aileler"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Bilinmeyen ilişki türü"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "İlişki türü \"Bilinmeyen\" olan aileyi bildir"

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Evlilik etkinliği eksik"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Evlilik etkinliği olmayan \"Evli\" türündeki aileyi bildir"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Evlilik tarihi ve yeri"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Evlilik etkinliğinin tarihini ve yerini denetle"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Boşanma tarihi ve yeri"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Boşanma etkinliğinin tarihini ve yerini denetle"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "İlişkiler"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Ebeveyn ailesi eksik"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Ebeveyn ailesi olmayan her kişiyi listele"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Eş eksik"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Yalnızca bir eşi olan aileyi bildir"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Baba eksik"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Ebeveyn ailesinde babası olmayan kişiyi bildir"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Anne eksik"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Ebeveyn ailesinde annesi olmayan kişiyi bildir"

#: WhatsNext.py:291
msgid "Events"
msgstr "Etkinlikler"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Bilinmeyen tarih"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Tarihi olmayan etkinliği bildir"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Tarih yalnızca metin"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Gramps'in tarih olarak okuyamadığı tarihi bildir"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Kesin olmayan tarih"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Bir aralığı, bir dönemi ya da \"önce\", \"sonra\", \"yaklaşık\", \"tahmini\""
" veya \"hesaplanmış\" içeren tarihi bildir"

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Eksik tarih"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Günü veya ayı olmayan tek tarihi bildir"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Bilinmeyen yer"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Yeri olmayan etkinliği bildir"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Eksik adı Kişiyi Düzenle penceresinde girin."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Kişiyi Düzenle penceresinin Etkinlikler sekmesinden ekleyin."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Etkinliği Kişiyi Düzenle penceresinin Etkinlikler sekmesinde açın ve "
"tarihini ve yerini tamamlayın."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Etkinliği Aileyi Düzenle penceresinin Etkinlikler sekmesinde açın ve "
"tarihini ve yerini tamamlayın."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Aileyi Düzenle penceresinin Etkinlikler sekmesinde bir Evlilik etkinliği "
"ekleyin."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Aileyi Düzenle penceresinde ilişki \"Tür\"ünü seçin."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Eksik eşi Aileyi Düzenle penceresinde ekleyin."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Babayı ebeveyn ailesinin Aileyi Düzenle penceresinde ekleyin."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Anneyi ebeveyn ailesinin Aileyi Düzenle penceresinde ekleyin."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"İlişkiler görünümünde Düzenle menüsünden \"Yeni Ebeveynler Ekle...\" veya "
"\"Mevcut Ebeveynleri Ekle...\" seçeneğini seçin."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Tamamlandı"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Yok sayıldı"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Budandı"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Henüz yerel bir soy ağacı veritabanı yüklenmedi.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Sonraki Adımlar:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  \"Aile Ağaçları\" menüsünden"

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " \"Aile Ağaçlarını Yönet...\" seçeneğini kullanarak"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " yeni bir ağaç veritabanı oluşturun (veya mevcut olanı seçin).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Seçilen soy ağacıyla çalışmaya başlamak için"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" \"Aile Ağacını yükle\" düğmesine tıklayın.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Gramps yedeğini veya başka bir soy ağacı aracından GEDCOM dosyasını kullanmak için \"Aile Ağaçları\" menüsünde \"İçe Aktar...\" seçeneğini seçin.\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Gramps yedeğini veya başka bir soy ağacı aracından GEDCOM dosyasını kullanmak için önce yeni, boş bir ağaç oluşturup yükleyin. Ardından \"Aile Ağaçları\" menüsünde \"İçe Aktar...\" seçeneğini seçin.\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Gramplet seçeneklerini değiştirmek için \"Görünüm\" menüsündeki "
"\"Yapılandır...\" seçeneğini kullanın."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Etiketleri Düzenle"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Tamamlandı"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Listelenen kişileri ve aileleri Tamamlandı olarak etiketle"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Yok say"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Kişileri ve aileleri yok saymak için etiketle"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Buda"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Listelenen kişileri ve aileleri denetimden budamak (dışlamak) için etiketle"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Arama Kotası "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr "Gösterilecek en az satır sayısı. Bu kadar sorun bulununca arama durur"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Döngü başına derinlik"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Bir kuşak daha üstsoya çıkmadan önce altsoyun kaç kuşağının denetleneceği"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Arama genişlemesini duraklat"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Bir üstsoy denetlendikten sonra o üstsoyun altsoyu denetlenmeden önce kaç ek"
" tur bekleneceği"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Tamamlandı etiketi"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Bitti. Nesneyi gizle ve onun içinden aramaya devam et"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Yok sayıldı etiketi"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Şimdilik bir kenara kondu. Nesneyi gizle ve onun içinden aramaya devam et"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Budandı etiketi"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Çıkmaz yol. Nesneyi gizle ve onun içinden aramayı durdur"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Önerilen 👣 Sonraki Adımları göster"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Yönlendirme adımlarını ve 👣 önerileri göster. Daha kısa bir liste için "
"kapatın"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Gözden geçir (düzenleyiciyi aç)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Tamamlandı olarak etiketle"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Yok saymak için etiketle"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Budamak için etiketle"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "%s olarak etiketle"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Geçerli ağaç veritabanında hiç kişi yok.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Sonraki Adımlar:\n"
" Bir aile ve o ailede bir kişi ekleyin:\n"
"  • Aile \"Ekle\" menüsünden eklenebilir\n"
"  • Kişi, eş (\"Baba/eş1\" veya \"Anne/eş2\") panellerinde ya da \"Çocuklar\" sekmesinde \"+\" (artı) düğmesine basılarak eklenebilir.\n"
"\n"
"Ya da kişileri harici bir dosyadan içe aktarın:\n"
"  • Ağacı doldurmak için \"Aile Ağaçları\" menüsündeki \"İçe Aktar...\" ile harici bir dosya kullanılabilir."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Merkezdeki \"Ana Kişi\" olarak hiçbir kişi seçilmedi.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Sonraki Adımlar:\n"
"  •  Gezgin kenar çubuğunda Kişiler görünümü simgesini seçin.\n"
"  •  Birini \"Etkin Kişi\" yapmak için seçin.\n"
"  •  Düzenle menüsünden veya (sağ tık) bağlam menüsünden \"Ana Kişiyi Belirle\" seçeneğini seçin.\n"
"\n"
" Bu, onu merkezdeki \"Ana Kişi\" yapar."

