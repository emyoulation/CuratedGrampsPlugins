#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "A seguir"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplet que sugere items a pesquisar"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Qual é o próximo?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Ajuda"

#: WhatsNext.py:206
msgid "People"
msgstr "Pessoas"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Nome próprio desconhecido"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Relatar uma pessoa sem nome próprio"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Sobrenome desconhecido"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Relatar uma pessoa sem sobrenome"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Falta o evento Nascimento"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Relatar uma pessoa sem evento Nascimento"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Data e local de nascimento"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Verificar a data e o local do evento Nascimento"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Falta o evento Falecimento"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Relatar uma pessoa sem evento Falecimento, quando o Gramps conclui pelas "
"datas da pessoa e dos parentes que ela já não está viva"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Data e local de falecimento"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Verificar a data e o local do evento Falecimento"

#: WhatsNext.py:241
msgid "Families"
msgstr "Famílias"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Tipo de relacionamento desconhecido"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Relatar uma família com o tipo de relacionamento \"Desconhecido\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Falta o evento Casamento"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Relatar uma família do tipo \"Casados\" sem evento Casamento"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Data e local do casamento"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Verificar a data e o local do evento Casamento"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Data e local do divórcio"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Verificar a data e o local do evento Divórcio"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Parentescos"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Falta a família dos pais"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Listar cada pessoa que não tem família dos pais"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Falta o parceiro"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Relatar uma família com apenas um parceiro"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Falta o pai"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Relatar uma pessoa cuja família dos pais não tem pai"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Falta a mãe"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Relatar uma pessoa cuja família dos pais não tem mãe"

#: WhatsNext.py:291
msgid "Events"
msgstr "Eventos"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Data desconhecida"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Relatar um evento sem data"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "A data é apenas texto"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Relatar uma data que o Gramps não conseguiu ler como data"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Data inexata"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Relatar um intervalo, um período ou uma data com \"antes de\", \"depois "
"de\", \"aproximadamente\", \"estimado\" ou \"calculado\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Data incompleta"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Relatar uma data simples sem dia ou mês"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Local desconhecido"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Relatar um evento sem local"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Digite o nome que falta na janela Editar pessoa."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Adicione pela aba Eventos da janela Editar pessoa."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Abra o evento na aba Eventos da janela Editar pessoa e complete a data e o "
"local."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Abra o evento na aba Eventos da janela Editar família e complete a data e o "
"local."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr "Adicione um evento Casamento na aba Eventos da janela Editar família."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Escolha o \"Tipo\" de relacionamento na janela Editar família."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Adicione o parceiro que falta na janela Editar família."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Adicione o pai na janela Editar família da família dos pais."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Adicione a mãe na janela Editar família da família dos pais."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"Na visualização Parentescos, escolha \"Adicionar novos pais...\" ou "
"\"Adicionar pais existentes...\" no menu Editar."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Concluído"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Ignorado"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Podado"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Nenhum banco de dados local de árvore genealógica foi carregado ainda.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Próximos passos:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  No menu \"Árvores genealógicas\","

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " use a opção \"Gerenciar árvores genealógicas...\" para"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " criar um novo banco de dados de árvore (ou selecionar um existente).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Clique no botão \"Carregar árvore genealógica\" para começar"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" a trabalhar com a árvore genealógica selecionada.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Para usar um backup do Gramps, ou um arquivo GEDCOM de outro programa de genealogia, escolha \"Importar...\" no menu \"Árvores genealógicas\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Para usar um backup do Gramps, ou um arquivo GEDCOM de outro programa de genealogia, primeiro crie e carregue uma nova árvore vazia. Depois escolha \"Importar...\" no menu \"Árvores genealógicas\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr "Use \"Configurar...\" no menu \"Exibir\" para alterar as opções do gramplet."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Organizar etiquetas"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Concluído"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Etiquetar as pessoas e famílias listadas como Concluídas"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Ignorar"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Etiquetar para ignorar pessoas e famílias"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Podar"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Etiquetar para podar (excluir) da verificação as pessoas e famílias listadas"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Cota de pesquisa "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"O número mínimo de linhas a exibir. A pesquisa para assim que esse número de"
" problemas é encontrado"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Profundidade por ciclo"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Quantas gerações de descendentes verificar antes de subir mais uma geração "
"de ascendentes"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Pausar a ampliação da pesquisa"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Quantas rodadas extras esperar depois de verificar um ascendente antes de "
"verificar os descendentes dele"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Etiqueta de concluído"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Concluído. Ocultar o objeto e continuar pesquisando através dele"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Etiqueta de ignorado"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Deixado de lado por enquanto. Ocultar o objeto e continuar pesquisando "
"através dele"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Etiqueta de podado"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Beco sem saída. Ocultar o objeto e parar de pesquisar através dele"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Exibir os 👣 próximos passos sugeridos"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Exibir os passos de orientação e as 👣 sugestões. Desative para uma lista "
"mais curta"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Revisar (abrir editor)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Etiquetar como Concluído"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Etiquetar para ignorar"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Etiquetar para podar"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Etiquetar como %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ O banco de dados da árvore atual não contém pessoas.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Próximos passos:\n"
" Adicione uma família e uma pessoa nessa família:\n"
"  • Uma família pode ser adicionada pelo menu \"Adicionar\"\n"
"  • Uma pessoa pode ser adicionada pressionando \"+\" (mais) nos painéis do casal (\"Pai/parceiro1\" ou \"Mãe/parceiro2\") ou na aba \"Filhos\".\n"
"\n"
"Ou importe pessoas de um arquivo externo:\n"
"  • Um arquivo externo pode ser usado para preencher a árvore por meio de \"Importar...\" no menu \"Árvores genealógicas\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Nenhuma pessoa foi escolhida como \"Pessoa predefinida\" central.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Próximos passos:\n"
"  •  Selecione o ícone da visualização Pessoas na barra lateral do Navegador.\n"
"  •  Selecione alguém para torná-lo a \"Pessoa ativa\".\n"
"  •  Escolha \"Definir a pessoa inicial\" no menu Editar ou no menu de contexto (clique com o botão direito).\n"
"\n"
" Isso a define como a \"Pessoa predefinida\" central."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Clique duas vezes no texto colorido para editar os detalhes"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "Pessoa predefinida central"

