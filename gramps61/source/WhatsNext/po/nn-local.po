#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Kva no"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Smågramps som føreslår emne å forska på"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Kva no?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Hjelp"

#: WhatsNext.py:206
msgid "People"
msgstr "Personar"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Ukjent førenamn"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Rapporter ein person utan førenamn"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Ukjent etternamn"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Rapporter ein person utan etternamn"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Manglar Fødsel-hending"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Rapporter ein person utan Fødsel-hending"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Fødselsdato og -stad"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Kontroller dato og stad for Fødsel-hendinga"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Manglar Død-hending"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Rapporter ein person utan Død-hending, når Gramps ut frå datoane til "
"personen og slektningane vurderer at personen ikkje lenger lever"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Dødsdato og -stad"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Kontroller dato og stad for Død-hendinga"

#: WhatsNext.py:241
msgid "Families"
msgstr "Familiar"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Ukjend relasjonstype"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Rapporter ein familie med relasjonstypen \"Ukjent\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Manglar Ekteskap-hending"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Rapporter ein familie av typen \"Gift\" utan Ekteskap-hending"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Vigselsdato og -stad"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Kontroller dato og stad for Ekteskap-hendinga"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Skilsmissedato og -stad"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Kontroller dato og stad for Skilsmisse-hendinga"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Slektskap"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Manglar foreldrefamilie"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "List opp kvar person som ikkje har nokon foreldrefamilie"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Manglar partnar"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Rapporter ein familie med berre éin partnar"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Manglar far"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Rapporter ein person der foreldrefamilien ikkje har nokon far"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Manglar mor"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Rapporter ein person der foreldrefamilien ikkje har noka mor"

#: WhatsNext.py:291
msgid "Events"
msgstr "Hendingar"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Ukjend dato"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Rapporter ei hending utan dato"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Datoen er berre tekst"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Rapporter ein dato som Gramps ikkje kunne lese som ein dato"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Unøyaktig dato"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Rapporter eit intervall, eit tidsrom eller ein dato med \"før\", \"etter\", "
"\"omkring\", \"anslått\" eller \"berekna\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Ufullstendig dato"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Rapporter ein enkeltdato utan dag eller månad"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Ukjend stad"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Rapporter ei hending utan stad"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Skriv inn namnet som manglar i dialogen Rediger person."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Legg til via fana Hendingar i dialogen Rediger person."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Opne hendinga i fana Hendingar i dialogen Rediger person, og fyll ut dato og"
" stad."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Opne hendinga i fana Hendingar i dialogen Rediger familie, og fyll ut dato "
"og stad."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Legg til ei Ekteskap-hending i fana Hendingar i dialogen Rediger familie."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Vel \"Type\" for relasjonen i dialogen Rediger familie."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Legg til partnaren som manglar i dialogen Rediger familie."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Legg til faren i dialogen Rediger familie for foreldrefamilien."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Legg til mora i dialogen Rediger familie for foreldrefamilien."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"I visninga Slektskap vel du \"Legg til nye foreldre...\" eller \"Legg til "
"eksisterande foreldre...\" frå menyen Rediger."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Komplett"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Ignorert"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Beskore"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Ingen lokal slektstre-database er henta inn enno.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Neste steg:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  Frå menyen \"Slektstre\""

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " bruker du \"Handsama slektstre...\" for å"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " opprette ein ny slektstre-database (eller velje ein eksisterande).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Klikk på knappen \"Hent inn Slektstre\" for å byrje"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" å arbeide med det valde slektstreet.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"For å bruke ein tryggleikskopi frå Gramps, eller ei GEDCOM-fil frå eit anna slektsprogram, vel du \"Importer...\" i menyen \"Slektstre\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"For å bruke ein tryggleikskopi frå Gramps, eller ei GEDCOM-fil frå eit anna slektsprogram, opprettar og hentar du først inn eit nytt, tomt slektstre. Vel deretter \"Importer...\" i menyen \"Slektstre\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Bruk \"Konfigurer...\" i menyen \"Vis\" for å endre innstillingane til "
"Grampleten."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Organiser markeringar"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Fullført"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Marker dei lista personane og familiane som Fullført"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Ignorer"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Marker personar og familiar for å ignorere dei"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Beskjer"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Marker dei lista personane og familiane for å beskjere (utelate) dei frå "
"kontrollen"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Søkjekvote "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Minste tal på linjer som blir viste. Søket stoppar når så mange problem er "
"funne"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Djupn per runde"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Kor mange generasjonar etterkomarar som blir kontrollerte før det går éin "
"generasjon aner opp"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Pause i utviding av søket"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Kor mange ekstra rundar det blir venta etter kontroll av ei ane før "
"etterkomarane til ana blir kontrollerte"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Markering for Fullført"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Ferdig. Skjul objektet, og hald fram søket gjennom det"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Markering for Ignorer"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Lagt til side inntil vidare. Skjul objektet, og hald fram søket gjennom det"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Markering for Beskjer"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Blindveg. Skjul objektet, og stopp søket gjennom det"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Vis føreslegne 👣 neste steg"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "Vis rettleiingsstega og 👣 framlegga. Slå av for ei kortare liste"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Gå gjennom (opne redigering)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Marker som Fullført"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Marker for å ignorere"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Marker for å beskjere"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Marker som %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Den gjeldande slektstre-databasen inneheld ingen personar.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Neste steg:\n"
" Legg til ein familie og ein person i den familien:\n"
"  • Ein familie kan leggjast til via menyen \"Legg til\"\n"
"  • Ein person kan leggjast til ved å trykkje på \"+\" (pluss) i ektefellepanela (\"Far/Partnar 1\" eller \"Mor/Partnar 2\") eller i fana \"Barn\".\n"
"\n"
"Eller importer personar frå ei ekstern fil:\n"
"  • Ei ekstern fil kan brukast til å fylle slektstreet via \"Importer...\" i menyen \"Slektstre\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Ingen person er vald som sentral \"Startperson\".\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Neste steg:\n"
"  •  Vel ikonet for visninga Personar i sidepanelet til Navigatoren.\n"
"  •  Vel nokon for å gjere vedkomande til \"Aktiv person\".\n"
"  •  Vel \"Vel startperson\" frå menyen Rediger eller frå hurtigmenyen (høgreklikk).\n"
"\n"
" Dette gjer vedkomande til sentral \"Startperson\"."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Dobbeltklikk på farga tekst for å redigere detaljar"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "sentral Startperson"

