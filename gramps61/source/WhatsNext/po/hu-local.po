#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Mi a következő"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Kutatni való elemeket javasló gramplet"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Mi a következő?"

#: WhatsNext.py:129
msgid "Help"
msgstr "Súgó"

#: WhatsNext.py:206
msgid "People"
msgstr "Emberek"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Ismeretlen utónév"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Utónév nélküli személy jelentése"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Ismeretlen vezetéknév"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Vezetéknév nélküli személy jelentése"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Hiányzó Születés esemény"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Születés esemény nélküli személy jelentése"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Születési dátum és hely"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "A Születés esemény dátumának és helyének ellenőrzése"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Hiányzó Halál esemény"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Halál esemény nélküli személy jelentése, ha a Gramps a személy és rokonai "
"dátumai alapján úgy ítéli, hogy a személy már nem él"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Halálozási dátum és hely"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "A Halál esemény dátumának és helyének ellenőrzése"

#: WhatsNext.py:241
msgid "Families"
msgstr "Családok"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Ismeretlen kapcsolattípus"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "\"Ismeretlen\" kapcsolattípusú család jelentése"

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Hiányzó Házasság esemény"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "\"Házas\" típusú, Házasság esemény nélküli család jelentése"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "A házasságkötés dátuma és helye"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "A Házasság esemény dátumának és helyének ellenőrzése"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "A válás dátuma és helye"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "A Válás esemény dátumának és helyének ellenőrzése"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Kapcsolatok"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Hiányzó szülői család"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Minden szülői család nélküli személy listázása"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Hiányzó partner"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Csak egy partnerrel rendelkező család jelentése"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Hiányzó apa"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Olyan személy jelentése, akinek a szülői családjában nincs apa"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Hiányzó anya"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Olyan személy jelentése, akinek a szülői családjában nincs anya"

#: WhatsNext.py:291
msgid "Events"
msgstr "Események"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Ismeretlen dátum"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Dátum nélküli esemény jelentése"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "A dátum csak szöveg"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr ""
"Olyan dátum jelentése, amelyet a Gramps nem tudott dátumként értelmezni"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Pontatlan dátum"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Időköz, időszak vagy \"korábban mint\", \"később mint\", \"nagyjából\", "
"\"becsült\" vagy \"számított\" jelzésű dátum jelentése"

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Hiányos dátum"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Nap vagy hónap nélküli egyszerű dátum jelentése"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Ismeretlen hely"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Hely nélküli esemény jelentése"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Adja meg a hiányzó nevet a Személy szerkesztése ablakban."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Adja hozzá a Személy szerkesztése ablak Események lapján."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Nyissa meg az eseményt a Személy szerkesztése ablak Események lapján, és "
"egészítse ki a dátumát és a helyét."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Nyissa meg az eseményt a Család szerkesztése ablak Események lapján, és "
"egészítse ki a dátumát és a helyét."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"Adjon hozzá Házasság eseményt a Család szerkesztése ablak Események lapján."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Válassza ki a kapcsolat \"Típus\"-át a Család szerkesztése ablakban."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Adja hozzá a hiányzó partnert a Család szerkesztése ablakban."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Adja hozzá az apát a szülői család Család szerkesztése ablakában."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Adja hozzá az anyát a szülői család Család szerkesztése ablakában."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"A Kapcsolatok nézetben válassza az \"Új szülők hozzáadása...\" vagy a "
"\"Létező szülők hozzáadása...\" pontot a Szerkesztés menüből."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Befejezett"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Figyelmen kívül hagyva"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Lenyesve"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Még nincs betöltve helyi családfa-adatbázis.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Következő lépések:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  A \"Családfák\" menüben"

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " a \"Családfák kezelése...\" pont segítségével"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " hozzon létre új családfa-adatbázist (vagy válasszon egy meglévőt).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Kattintson a \"Családfa betöltése\" gombra, hogy"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" megkezdhesse a munkát a kiválasztott családfával.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Gramps biztonsági mentés vagy más családfakutató program GEDCOM-fájljának használatához válassza az \"Importálás...\" pontot a \"Családfák\" menüben.\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Gramps biztonsági mentés vagy más családfakutató program GEDCOM-fájljának használatához előbb hozzon létre és töltsön be egy új, üres családfát. Ezután válassza az \"Importálás...\" pontot a \"Családfák\" menüben.\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"A Gramplet beállításainak módosításához használja a \"Nézet\" menü "
"\"Beállítás...\" pontját."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Címkék szervezése"

#: WhatsNext.py:719
msgid "Complete"
msgstr "Teljes"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "A listázott személyek és családok megcímkézése Kész címkével"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Mellőzés"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Címke személyek és családok mellőzéséhez"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Nyesés"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Címke a listázott személyek és családok ellenőrzésből való lenyeséséhez "
"(kizárásához)"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Keresési kvóta "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"A megjelenítendő sorok legkisebb száma. A keresés leáll, amint ennyi "
"probléma előkerül"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Mélység körönként"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"Hány leszármazotti nemzedéket ellenőrizzen, mielőtt egy további ősi "
"nemzedékkel feljebb lép"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "A keresés bővítésének szüneteltetése"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Hány további kört várjon egy ős ellenőrzése után, mielőtt az ős "
"leszármazottait ellenőrzi"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Kész címke"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr ""
"Befejezve. Az objektum elrejtése, és a keresés folytatása rajta keresztül"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Mellőzés címke"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr ""
"Egyelőre félretéve. Az objektum elrejtése, és a keresés folytatása rajta "
"keresztül"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Nyesés címke"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr ""
"Zsákutca. Az objektum elrejtése, és a keresés leállítása rajta keresztül"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "A javasolt 👣 következő lépések megjelenítése"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"Az útmutató lépések és a 👣 javaslatok megjelenítése. Kapcsolja ki a rövidebb"
" listához"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Áttekintés (szerkesztő megnyitása)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Megcímkézés Kész címkével"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Megcímkézés mellőzésre"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Megcímkézés nyesésre"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Megcímkézés: %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ A jelenlegi családfa-adatbázis nem tartalmaz személyeket.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Következő lépések:\n"
" Adjon hozzá egy családot és egy személyt ebben a családban:\n"
"  • Családot a \"Hozzáadás\" menüből lehet hozzáadni\n"
"  • Személyt a házastársi panelekben (\"Apa/1. partner\" vagy \"Anya/2. partner\") vagy a \"Gyermekek\" lapon a \"+\" (plusz) gombbal lehet hozzáadni.\n"
"\n"
"Vagy importáljon személyeket külső fájlból:\n"
"  • Külső fájllal a \"Családfák\" menü \"Importálás...\" pontján keresztül tölthető fel a családfa."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Nincs személy kiválasztva központi \"Kiinduló személy\"-ként.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Következő lépések:\n"
"  •  Válassza ki a Személyek nézet ikonját a Navigátor oldalsávjában.\n"
"  •  Válasszon ki valakit, hogy ő legyen az \"Aktív személy\".\n"
"  •  Válassza \"A kiinduló személy beállítása\" pontot a Szerkesztés menüből vagy a helyi menüből (jobb kattintás).\n"
"\n"
" Ezzel ő lesz a központi \"Kiinduló személy\"."

#: WhatsNext.py:1645
msgid "Double-click color text to edit details"
msgstr "Kattintson duplán a színes szövegre a részletek szerkesztéséhez"

#: WhatsNext.py:1664
msgid "focal Home Person"
msgstr "központi Kiinduló személy"

