#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "Tiếp theo là gì "

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "Gramplet đề nghị các mục nghiên cứu "

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "Tiếp theo là gì? "

#: WhatsNext.py:129
msgid "Help"
msgstr "Trợ giúp"

#: WhatsNext.py:206
msgid "People"
msgstr "Người "

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "Không biết tên"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "Báo cáo người không có tên"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "Không biết họ"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "Báo cáo người không có họ"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "Thiếu sự kiện Sinh"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "Báo cáo người không có sự kiện Sinh"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "Ngày và nơi sinh"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "Kiểm tra ngày và nơi của sự kiện Sinh"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "Thiếu sự kiện Chết"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"Báo cáo người không có sự kiện Chết, khi Gramps đánh giá theo các ngày của "
"người đó và người thân rằng người đó không còn sống"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "Ngày và nơi mất"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "Kiểm tra ngày và nơi của sự kiện Chết"

#: WhatsNext.py:241
msgid "Families"
msgstr "Gia đình "

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "Không biết loại quan hệ"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "Báo cáo gia đình có loại quan hệ \"Không biết\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "Thiếu sự kiện Hôn nhân"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "Báo cáo gia đình thuộc loại \"Kết hôn\" mà không có sự kiện Hôn nhân"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "Ngày và nơi kết hôn"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "Kiểm tra ngày và nơi của sự kiện Hôn nhân"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "Ngày và nơi li dị"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "Kiểm tra ngày và nơi của sự kiện Li dị"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "Quan hệ "

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "Thiếu gia đình cha mẹ"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "Liệt kê từng người không có gia đình cha mẹ"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "Thiếu người hôn phối"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "Báo cáo gia đình chỉ có một người hôn phối"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "Thiếu cha"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "Báo cáo người có gia đình cha mẹ không có cha"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "Thiếu mẹ"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "Báo cáo người có gia đình cha mẹ không có mẹ"

#: WhatsNext.py:291
msgid "Events"
msgstr "Sự kiện"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "Không biết ngày"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "Báo cáo sự kiện không có ngày"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "Ngày chỉ là văn bản"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Báo cáo ngày mà Gramps không đọc được như một ngày"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "Ngày không chính xác"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"Báo cáo khoảng, thời kỳ, hoặc ngày có \"trước\", \"sau\", \"khoảng\", "
"\"phỏng chừng\" hoặc \"được tính\""

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "Ngày không đầy đủ"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "Báo cáo ngày đơn lẻ thiếu ngày hoặc tháng"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "Không biết nơi"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "Báo cáo sự kiện không có nơi"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "Nhập tên còn thiếu trong hộp thoại Sửa người."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "Thêm qua thẻ Sự kiện của hộp thoại Sửa người."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"Mở sự kiện trên thẻ Sự kiện của hộp thoại Sửa người, rồi hoàn tất ngày và "
"nơi của nó."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"Mở sự kiện trên thẻ Sự kiện của hộp thoại Sửa gia đình, rồi hoàn tất ngày và"
" nơi của nó."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr "Thêm sự kiện Hôn nhân trên thẻ Sự kiện của hộp thoại Sửa gia đình."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "Chọn \"Loại\" quan hệ trong hộp thoại Sửa gia đình."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "Thêm người hôn phối còn thiếu trong hộp thoại Sửa gia đình."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "Thêm cha trong hộp thoại Sửa gia đình của gia đình cha mẹ."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "Thêm mẹ trong hộp thoại Sửa gia đình của gia đình cha mẹ."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"Trong khung xem Quan hệ, chọn \"Thêm cha mẹ...\" hoặc \"Thêm cha mẹ đang "
"có...\" từ trình đơn Sửa."

#: WhatsNext.py:400
msgid "Completed"
msgstr "Hoàn tất "

#: WhatsNext.py:402
msgid "Ignored"
msgstr "Đã bỏ qua"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "Đã tỉa"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ Chưa tải cơ sở dữ liệu Cây gia phả cục bộ nào.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 Bước tiếp theo:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  Từ trình đơn \"Cây gia đình\","

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " dùng tùy chọn \"Quản lý Cây gia đình...\" để"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " tạo một cơ sở dữ liệu Cây mới (hoặc chọn một cây có sẵn).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  Nhấn nút \"Tải Cây gia đình\" để bắt đầu"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" làm việc với cây gia phả đã chọn.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Để dùng bản sao lưu từ Gramps, hoặc tệp GEDCOM từ một công cụ gia phả khác, chọn \"Nhập...\" trong trình đơn \"Cây gia đình\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Để dùng bản sao lưu từ Gramps, hoặc tệp GEDCOM từ một công cụ gia phả khác, trước hết hãy tạo và tải một cây mới, trống. Sau đó chọn \"Nhập...\" trong trình đơn \"Cây gia đình\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"Dùng \"Đặt cấu hình...\" trong trình đơn \"Xem\" để thay đổi tùy chọn của "
"Gramplet."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "Xếp thẻ "

#: WhatsNext.py:719
msgid "Complete"
msgstr "Hoàn tất "

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "Gắn thẻ Hoàn tất cho những Người và Gia đình được liệt kê"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "Bỏ qua"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "Gắn thẻ để Bỏ qua Người và Gia đình"

#: WhatsNext.py:739
msgid "Prune"
msgstr "Tỉa"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"Gắn thẻ để Tỉa (loại trừ) những Người và Gia đình được liệt kê khỏi việc "
"kiểm tra"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "Hạn mức tìm kiếm "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"Số dòng tối thiểu để hiển thị. Việc tìm kiếm dừng lại khi đã tìm thấy chừng "
"ấy vấn đề"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "Độ sâu mỗi vòng"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr "Số thế hệ con cháu cần kiểm tra trước khi lên thêm một thế hệ tổ tiên"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "Tạm dừng mở rộng tìm kiếm"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"Số vòng thêm phải chờ sau khi kiểm tra một tổ tiên trước khi kiểm tra con "
"cháu của tổ tiên đó"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "Thẻ Hoàn tất"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "Đã xong. Ẩn đối tượng, và tiếp tục tìm kiếm qua nó"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "Thẻ Bỏ qua"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "Tạm gác lại. Ẩn đối tượng, và tiếp tục tìm kiếm qua nó"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "Thẻ Tỉa"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "Ngõ cụt. Ẩn đối tượng, và ngừng tìm kiếm qua nó"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "Hiện 👣 Bước tiếp theo được đề xuất"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr "Hiện các bước hướng dẫn và 👣 đề xuất. Tắt đi để có danh sách ngắn hơn"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_Xem lại (mở trình sửa)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "Gắn thẻ Hoàn tất"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "Gắn thẻ Bỏ qua"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "Gắn thẻ Tỉa"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "Gắn thẻ %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ Cơ sở dữ liệu Cây hiện tại không có người nào.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 Bước tiếp theo:\n"
" Thêm một Gia đình và một người trong gia đình đó:\n"
"  • Có thể thêm Gia đình qua trình đơn \"Thêm\"\n"
"  • Có thể thêm người bằng cách nhấn \"+\" (cộng) trong khung vợ chồng (\"Cha/hôn phối1\" hoặc \"Mẹ/hôn phối2\") hoặc thẻ \"Con cái\".\n"
"\n"
"Hoặc Nhập Người từ một tệp bên ngoài:\n"
"  • Có thể dùng tệp bên ngoài để điền vào cây qua \"Nhập...\" trong trình đơn \"Cây gia đình\"."

#: WhatsNext.py:1632
msgid ""
"\n"
" ⛔ No Person has been chosen as the focal \"Home Person\".\n"
msgstr ""
"\n"
" ⛔ Chưa chọn người nào làm \"Người mặc định\" trung tâm.\n"

#: WhatsNext.py:1635
msgid ""
"\n"
" 👣 Next Steps:\n"
"  •  Select the People view icon in the Navigator sidebar.\n"
"  •  Select someone to make them the \"Active Person\".\n"
"  •  Choose \"Set Home Person\" from the Edit menu or from the (right-click) context menu.\n"
"\n"
" This sets them as the focal \"Home Person\"."
msgstr ""
"\n"
" 👣 Bước tiếp theo:\n"
"  •  Chọn biểu tượng khung xem Người trong thanh bên Bộ điều hướng.\n"
"  •  Chọn một người để đặt làm \"Người hiện hành\".\n"
"  •  Chọn \"Đặt người gốc\" từ trình đơn Sửa hoặc từ trình đơn ngữ cảnh (nhấn chuột phải).\n"
"\n"
" Việc này đặt người đó làm \"Người mặc định\" trung tâm."

