#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "რა არის შემდეგი"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "გრამპლეტი, რომელიც კვლევის საგნებს გთავაზობთ"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "რა არის შემდეგი?"

#: WhatsNext.py:129
msgid "Help"
msgstr "დახმარება"

#: WhatsNext.py:206
msgid "People"
msgstr "ხალხი"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "უცნობი სახელი"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "პიროვნების შეტყობინება სახელის გარეშე"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "უცნობი გვარი"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "პიროვნების შეტყობინება გვარის გარეშე"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "დაბადების მოვლენა აკლია"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "პიროვნების შეტყობინება დაბადების მოვლენის გარეშე"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "დაბადების თარიღი და ადგილი"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "დაბადების მოვლენის თარიღისა და ადგილის შემოწმება"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "სიკვდილის მოვლენა აკლია"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"პიროვნების შეტყობინება სიკვდილის მოვლენის გარეშე, როცა Gramps პიროვნებისა და"
" ნათესავების თარიღებით ასკვნის, რომ პიროვნება აღარ არის ცოცხალი"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "სიკვდილის თარიღი და ადგილი"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "სიკვდილის მოვლენის თარიღისა და ადგილის შემოწმება"

#: WhatsNext.py:241
msgid "Families"
msgstr "ოჯახები"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "ურთიერთობის უცნობი ტიპი"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "ოჯახის შეტყობინება ურთიერთობის ტიპით \"უცნობი\""

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "ქორწინების მოვლენა აკლია"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "\"დაქორწინებული\" ტიპის ოჯახის შეტყობინება ქორწინების მოვლენის გარეშე"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "ქორწინების თარიღი და ადგილი"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "ქორწინების მოვლენის თარიღისა და ადგილის შემოწმება"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "გაყრის თარიღი და ადგილი"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "გაყრის მოვლენის თარიღისა და ადგილის შემოწმება"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "ურთიერთობები"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "მშობლების ოჯახი აკლია"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "ყველა პიროვნების ჩამოთვლა, ვისაც მშობლების ოჯახი არ აქვს"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "პარტნიორი აკლია"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "მხოლოდ ერთი პარტნიორის მქონე ოჯახის შეტყობინება"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "მამა აკლია"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "პიროვნების შეტყობინება, რომლის მშობლების ოჯახში მამა არ არის"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "დედა აკლია"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "პიროვნების შეტყობინება, რომლის მშობლების ოჯახში დედა არ არის"

#: WhatsNext.py:291
msgid "Events"
msgstr "მოვლენები"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "უცნობი თარიღი"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "მოვლენის შეტყობინება თარიღის გარეშე"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "თარიღი მხოლოდ ტექსტია"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "თარიღის შეტყობინება, რომელიც Gramps-მა ვერ წაიკითხა თარიღად"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "არაზუსტი თარიღი"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"დიაპაზონის, პერიოდის ან \"მანამდე\", \"შემდეგ\", \"დაახლოებით\", "
"\"შეფასებული\" ან \"გამოთვლილი\" თარიღის შეტყობინება"

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "არასრული თარიღი"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "ერთეული თარიღის შეტყობინება დღის ან თვის გარეშე"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "უცნობი ადგილი"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "მოვლენის შეტყობინება ადგილის გარეშე"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "შეიყვანეთ დაკლებული სახელი დიალოგში \"პიროვნების ჩასწორება\"."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "დაამატეთ დიალოგის \"პიროვნების ჩასწორება\" ჩანართიდან \"მოვლენები\"."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"გახსენით მოვლენა დიალოგის \"პიროვნების ჩასწორება\" ჩანართზე \"მოვლენები\" და"
" შეავსეთ მისი თარიღი და ადგილი."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"გახსენით მოვლენა დიალოგის \"ოჯახის ჩასწორება\" ჩანართზე \"მოვლენები\" და "
"შეავსეთ მისი თარიღი და ადგილი."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"დაამატეთ ქორწინების მოვლენა დიალოგის \"ოჯახის ჩასწორება\" ჩანართზე "
"\"მოვლენები\"."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "აირჩიეთ ურთიერთობის \"ტიპი\" დიალოგში \"ოჯახის ჩასწორება\"."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "დაამატეთ დაკლებული პარტნიორი დიალოგში \"ოჯახის ჩასწორება\"."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr "დაამატეთ მამა მშობლების ოჯახის დიალოგში \"ოჯახის ჩასწორება\"."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr "დაამატეთ დედა მშობლების ოჯახის დიალოგში \"ოჯახის ჩასწორება\"."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"ხედში \"ურთიერთობები\" აირჩიეთ \"ახალი მშობლების დამატება...\" ან \"არსებული"
" მშობლების დამატება...\" მენიუდან \"ჩასწორება\"."

#: WhatsNext.py:400
msgid "Completed"
msgstr "დასრულებულია"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "იგნორირებული"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "გასხეპილი"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ ლოკალური გენეალოგიური ხის მონაცემთა ბაზა ჯერ არ არის ჩატვირთული.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 შემდეგი ნაბიჯები:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  მენიუდან \"საოჯახო ხეები\""

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " გამოიყენეთ ოფცია \"საოჯახო ხეების მართვა...\", რათა"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr " შექმნათ ახალი ხის მონაცემთა ბაზა (ან აირჩიოთ არსებული).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  დააწკაპუნეთ ღილაკზე \"საოჯახო ხის ჩატვირთვა\", რათა დაიწყოთ"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" მუშაობა არჩეულ გენეალოგიურ ხესთან.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Gramps-ის სარეზერვო ასლის ან სხვა გენეალოგიური პროგრამის GEDCOM ფაილის გამოსაყენებლად აირჩიეთ \"შემოტანა...\" მენიუში \"საოჯახო ხეები\".\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Gramps-ის სარეზერვო ასლის ან სხვა გენეალოგიური პროგრამის GEDCOM ფაილის გამოსაყენებლად ჯერ შექმენით და ჩატვირთეთ ახალი, ცარიელი ხე. შემდეგ აირჩიეთ \"შემოტანა...\" მენიუში \"საოჯახო ხეები\".\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr "გრამპლეტის პარამეტრების შესაცვლელად გამოიყენეთ \"მორგება\" მენიუში \"ხედი\"."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "ჭდეების ორგანიზება"

#: WhatsNext.py:719
msgid "Complete"
msgstr "დასრულებული"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr "ჩამოთვლილი პიროვნებებისა და ოჯახებისთვის ჭდის \"დასრულებული\" მინიჭება"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "იგნორირება"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "პიროვნებებისა და ოჯახების იგნორირების ჭდე"

#: WhatsNext.py:739
msgid "Prune"
msgstr "გასხეპვა"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"ჩამოთვლილი პიროვნებებისა და ოჯახების შემოწმებიდან გასხეპვის (გამორიცხვის) "
"ჭდე"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "ძიების კვოტა "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"საჩვენებელი ხაზების მინიმალური რაოდენობა. ძიება ჩერდება, როგორც კი ამდენი "
"პრობლემა მოიძებნება"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "სიღრმე თითო ციკლზე"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"შთამომავლების რამდენი თაობა შემოწმდეს, სანამ წინაპრების კიდევ ერთი თაობით "
"ავა ზემოთ"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "ძიების გაფართოების შეჩერება"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"რამდენი დამატებითი რაუნდი დაელოდოს წინაპრის შემოწმების შემდეგ, სანამ ამ "
"წინაპრის შთამომავლებს შეამოწმებს"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "დასრულების ჭდე"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
msgstr "დასრულებულია. ობიექტის დამალვა და მასში ძიების გაგრძელება"

#: WhatsNext.py:862
msgid "Ignore tag"
msgstr "იგნორირების ჭდე"

#: WhatsNext.py:864
msgid "Set aside for now. Hide the object, and keep searching through it"
msgstr "ჯერჯერობით გადადებულია. ობიექტის დამალვა და მასში ძიების გაგრძელება"

#: WhatsNext.py:870
msgid "Prune tag"
msgstr "გასხეპვის ჭდე"

#: WhatsNext.py:871
msgid "Dead end. Hide the object, and stop searching through it"
msgstr "ჩიხი. ობიექტის დამალვა და მასში ძიების შეწყვეტა"

#: WhatsNext.py:888
msgid "Show suggested 👣 Next Steps"
msgstr "შემოთავაზებული 👣 შემდეგი ნაბიჯების ჩვენება"

#: WhatsNext.py:891
msgid ""
"Show the guidance steps and the 👣 suggestions. Turn off for a shorter list"
msgstr ""
"სახელმძღვანელო ნაბიჯებისა და 👣 შემოთავაზებების ჩვენება. გამორთეთ უფრო მოკლე "
"სიისთვის"

#: WhatsNext.py:1277
msgid "_Review (open editor)"
msgstr "_მიმოხილვა (რედაქტორის გახსნა)"

#: WhatsNext.py:1287
msgid "Tag as Complete"
msgstr "ჭდე: დასრულებული"

#: WhatsNext.py:1288
msgid "Tag to Ignore"
msgstr "ჭდე: იგნორირება"

#: WhatsNext.py:1289
msgid "Tag to Prune"
msgstr "ჭდე: გასხეპვა"

#: WhatsNext.py:1529
#, python-format
msgid "Tag as %s"
msgstr "ჭდე: %s"

#: WhatsNext.py:1613
msgid ""
"\n"
" ⛔ The current Tree database contains no people.\n"
msgstr ""
"\n"
" ⛔ მიმდინარე ხის მონაცემთა ბაზა პიროვნებებს არ შეიცავს.\n"

#: WhatsNext.py:1616
msgid ""
"\n"
" 👣 Next Steps:\n"
" Add a Family and a person in that family:\n"
"  • A Family may be added via the \"Add\" menu\n"
"  • A person may be added by pressing the \"+\" (plus) in the spouse (\"Father/partner1\" or \"Mother/partner2\") panels or \"Children\" tab.\n"
"\n"
"Or Import People from an external file:\n"
"  • An external file may be used to populate the tree via \"Import...\" in the \"Family Trees\" menu."
msgstr ""
"\n"
" 👣 შემდეგი ნაბიჯები:\n"
" დაამატეთ ოჯახი და პიროვნება ამ ოჯახში:\n"
"  • ოჯახის დამატება შესაძლებელია მენიუდან \"დამატება\"\n"
"  • პიროვნების დამატება შესაძლებელია \"+\" (პლუს) ღილაკით მეუღლეების პანელებში (\"მამა/პარტნიორი1\" ან \"დედა/პარტნიორი2\") ან ჩანართზე \"შვილები\".\n"
"\n"
"ან შემოიტანეთ პიროვნებები გარე ფაილიდან:\n"
"  • გარე ფაილით ხის შევსება შესაძლებელია \"შემოტანა...\"-ით მენიუში \"საოჯახო ხეები\"."

#: WhatsNext.py:1632
msgid ""
"\n"
