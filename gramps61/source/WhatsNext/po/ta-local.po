#: WhatsNext.gpr.py:52
msgid "What's Next"
msgstr "அடுத்து என்ன"

#: WhatsNext.gpr.py:53
msgid "Gramplet suggesting items to research"
msgstr "கிராம்ப் ஆராய்ச்சிக்கு உருப்படிகளை பரிந்துரைக்கிறது"

#: WhatsNext.gpr.py:66
msgid "What's Next?"
msgstr "அடுத்து என்ன?"

#: WhatsNext.py:129
msgid "Help"
msgstr "உதவி"

#: WhatsNext.py:206
msgid "People"
msgstr "மக்கள்"

#: WhatsNext.py:210
msgid "Unknown first name"
msgstr "முதல் பெயர் தெரியவில்லை"

#: WhatsNext.py:211
msgid "Report a person without a first name"
msgstr "முதல் பெயர் இல்லாத நபரைத் தெரிவி"

#: WhatsNext.py:213
msgid "Unknown surname"
msgstr "குடும்பப்பெயர் தெரியவில்லை"

#: WhatsNext.py:213
msgid "Report a person without a surname"
msgstr "குடும்பப்பெயர் இல்லாத நபரைத் தெரிவி"

#: WhatsNext.py:216
msgid "Missing Birth event"
msgstr "பிறப்பு நிகழ்வு இல்லை"

#: WhatsNext.py:217
msgid "Report a person without a Birth event"
msgstr "பிறப்பு நிகழ்வு இல்லாத நபரைத் தெரிவி"

#: WhatsNext.py:221
msgid "Birth date and place"
msgstr "பிறந்த தேதி மற்றும் இடம்"

#: WhatsNext.py:222
msgid "Check the date and place of the Birth event"
msgstr "பிறப்பு நிகழ்வின் தேதியையும் இடத்தையும் சரிபார்"

#: WhatsNext.py:226
msgid "Missing Death event"
msgstr "இறப்பு நிகழ்வு இல்லை"

#: WhatsNext.py:228
msgid ""
"Report a person without a Death event, when Gramps judges from the dates of "
"the person and relatives that the person is no longer alive"
msgstr ""
"நபர் மற்றும் உறவினர்களின் தேதிகளின்படி அந்த நபர் இப்போது உயிருடன் இல்லை "
"என்று Gramps கணிக்கும்போது, இறப்பு நிகழ்வு இல்லாத நபரைத் தெரிவி"

#: WhatsNext.py:235
msgid "Death date and place"
msgstr "இறந்த தேதி மற்றும் இடம்"

#: WhatsNext.py:236
msgid "Check the date and place of the Death event"
msgstr "இறப்பு நிகழ்வின் தேதியையும் இடத்தையும் சரிபார்"

#: WhatsNext.py:241
msgid "Families"
msgstr "குடும்பங்கள்"

#: WhatsNext.py:245
msgid "Unknown relationship type"
msgstr "உறவு வகை தெரியவில்லை"

#: WhatsNext.py:246
msgid "Report a family with the relationship type \"Unknown\""
msgstr "உறவு வகை \"தெரியாத\" என உள்ள குடும்பத்தைத் தெரிவி"

#: WhatsNext.py:250
msgid "Missing Marriage event"
msgstr "திருமண நிகழ்வு இல்லை"

#: WhatsNext.py:251
msgid "Report a family of the \"Married\" type without a Marriage event"
msgstr "திருமண நிகழ்வு இல்லாத \"மணமான\" வகைக் குடும்பத்தைத் தெரிவி"

#: WhatsNext.py:255
msgid "Marriage date and place"
msgstr "திருமணத் தேதி மற்றும் இடம்"

#: WhatsNext.py:256
msgid "Check the date and place of the Marriage event"
msgstr "திருமண நிகழ்வின் தேதியையும் இடத்தையும் சரிபார்"

#: WhatsNext.py:260
msgid "Divorce date and place"
msgstr "மணவிலக்குத் தேதி மற்றும் இடம்"

#: WhatsNext.py:261
msgid "Check the date and place of the Divorce event"
msgstr "மணவிலக்கு நிகழ்வின் தேதியையும் இடத்தையும் சரிபார்"

#: WhatsNext.py:266
msgid "Relationships"
msgstr "உறவுகள்"

#: WhatsNext.py:270
msgid "Missing parent family"
msgstr "பெற்றோர் குடும்பம் இல்லை"

#: WhatsNext.py:271
msgid "List each person who has no parent family"
msgstr "பெற்றோர் குடும்பம் இல்லாத ஒவ்வொரு நபரையும் பட்டியலிடு"

#: WhatsNext.py:275
msgid "Missing partner"
msgstr "கூட்டாளர் இல்லை"

#: WhatsNext.py:276
msgid "Report a family with only one partner"
msgstr "ஒரே ஒரு கூட்டாளர் உள்ள குடும்பத்தைத் தெரிவி"

#: WhatsNext.py:280
msgid "Missing father"
msgstr "தந்தை இல்லை"

#: WhatsNext.py:281
msgid "Report a person whose parent family has no father"
msgstr "பெற்றோர் குடும்பத்தில் தந்தை இல்லாத நபரைத் தெரிவி"

#: WhatsNext.py:285
msgid "Missing mother"
msgstr "தாய் இல்லை"

#: WhatsNext.py:286
msgid "Report a person whose parent family has no mother"
msgstr "பெற்றோர் குடும்பத்தில் தாய் இல்லாத நபரைத் தெரிவி"

#: WhatsNext.py:291
msgid "Events"
msgstr "நிகழ்வுகள்"

#: WhatsNext.py:293
msgid "Unknown date"
msgstr "தேதி தெரியவில்லை"

#: WhatsNext.py:293
msgid "Report an event without a date"
msgstr "தேதி இல்லாத நிகழ்வைத் தெரிவி"

#: WhatsNext.py:296
msgid "Date is text only"
msgstr "தேதி உரை மட்டுமே"

#: WhatsNext.py:297
msgid "Report a date that Gramps could not read as a date"
msgstr "Gramps தேதியாகப் படிக்க முடியாத தேதியைத் தெரிவி"

#: WhatsNext.py:301
msgid "Inexact date"
msgstr "துல்லியமற்ற தேதி"

#: WhatsNext.py:303
msgid ""
"Report a range, a span, or a date with \"before\", \"after\", \"about\", "
"\"estimated\" or \"calculated\""
msgstr ""
"வரம்பு, காலம், அல்லது \"முன்\", \"பிறகு\", \"சுமார்\", \"மதிப்பிடப்பட்டது\" "
"அல்லது \"கணக்கிடப்பட்டது\" உள்ள தேதியைத் தெரிவி"

#: WhatsNext.py:309
msgid "Incomplete date"
msgstr "முழுமையற்ற தேதி"

#: WhatsNext.py:310
msgid "Report a single date without its day or month"
msgstr "நாள் அல்லது மாதம் இல்லாத தனித் தேதியைத் தெரிவி"

#: WhatsNext.py:312
msgid "Unknown place"
msgstr "இடம் தெரியவில்லை"

#: WhatsNext.py:312
msgid "Report an event without a place"
msgstr "இடம் இல்லாத நிகழ்வைத் தெரிவி"

#: WhatsNext.py:330
msgid "Enter the missing name in the Edit Person dialog."
msgstr "விடுபட்ட பெயரை நபரை திருத்து உரையாடலில் உள்ளிடவும்."

#: WhatsNext.py:331
msgid "Add via the Events tab of the Edit Person dialog."
msgstr "நபரை திருத்து உரையாடலின் நிகழ்வுகள் தாவல் வழியாகச் சேர்க்கவும்."

#: WhatsNext.py:333
msgid ""
"Open the event on the Events tab of the Edit Person dialog, and complete its"
" date and place."
msgstr ""
"நபரை திருத்து உரையாடலின் நிகழ்வுகள் தாவலில் நிகழ்வைத் திறந்து, அதன் "
"தேதியையும் இடத்தையும் நிறைவு செய்யவும்."

#: WhatsNext.py:337
msgid ""
"Open the event on the Events tab of the Edit Family dialog, and complete its"
" date and place."
msgstr ""
"குடும்பத்தைத் திருத்து உரையாடலின் நிகழ்வுகள் தாவலில் நிகழ்வைத் திறந்து, அதன்"
" தேதியையும் இடத்தையும் நிறைவு செய்யவும்."

#: WhatsNext.py:340
msgid "Add a Marriage event on the Events tab of the Edit Family dialog."
msgstr ""
"குடும்பத்தைத் திருத்து உரையாடலின் நிகழ்வுகள் தாவலில் திருமண நிகழ்வைச் "
"சேர்க்கவும்."

#: WhatsNext.py:341
msgid "Choose the relationship \"Type\" in the Edit Family dialog."
msgstr "குடும்பத்தைத் திருத்து உரையாடலில் உறவின் \"வகை\"யைத் தேர்ந்தெடுக்கவும்."

#: WhatsNext.py:342
msgid "Add the missing partner in the Edit Family dialog."
msgstr "விடுபட்ட கூட்டாளரை குடும்பத்தைத் திருத்து உரையாடலில் சேர்க்கவும்."

#: WhatsNext.py:343
msgid "Add the father in the Edit Family dialog of the parent family."
msgstr ""
"பெற்றோர் குடும்பத்தின் குடும்பத்தைத் திருத்து உரையாடலில் தந்தையைச் "
"சேர்க்கவும்."

#: WhatsNext.py:344
msgid "Add the mother in the Edit Family dialog of the parent family."
msgstr ""
"பெற்றோர் குடும்பத்தின் குடும்பத்தைத் திருத்து உரையாடலில் தாயைச் சேர்க்கவும்."

#: WhatsNext.py:346
msgid ""
"In the Relationships view, choose \"Add New Parents...\" or \"Add Existing "
"Parents...\" from the Edit menu."
msgstr ""
"உறவுகள் காட்சியில், திருத்து பட்டியலிலிருந்து \"புதிய பெற்றோரைச் சேர்க்கவும்"
" ...\" அல்லது \"இருக்கும் பெற்றோரைச் சேர்க்கவும் ...\" என்பதைத் "
"தேர்ந்தெடுக்கவும்."

#: WhatsNext.py:400
msgid "Completed"
msgstr "முடிந்தது"

#: WhatsNext.py:402
msgid "Ignored"
msgstr "புறக்கணிக்கப்பட்டது"

#: WhatsNext.py:404
msgid "Pruned"
msgstr "கத்தரிக்கப்பட்டது"

#: WhatsNext.py:546
msgid ""
"\n"
" ⛔ A local Genealogical Tree database has not yet been loaded.\n"
"\n"
msgstr ""
"\n"
" ⛔ உள்ளூர் மரபுவழி மரத் தரவுத்தளம் இன்னும் ஏற்றப்படவில்லை.\n"
"\n"

#: WhatsNext.py:548
msgid " 👣 Next Steps:\n"
msgstr " 👣 அடுத்த படிகள்:\n"

#: WhatsNext.py:549
msgid "  •  From the \"Family Trees\" menu,"
msgstr "  •  \"குடும்ப மரங்கள்\" பட்டியலிலிருந்து,"

#: WhatsNext.py:550
msgid " use the \"Manage Family Trees...\" option to"
msgstr " \"குடும்ப மரங்களை நிர்வகிக்கவும் ...\" விருப்பத்தைப் பயன்படுத்தி"

#: WhatsNext.py:551
msgid " create a New (or to select an existing) Tree database.\n"
msgstr ""
" புதிய மரத் தரவுத்தளத்தை உருவாக்கவும் (அல்லது இருக்கும் ஒன்றைத் "
"தேர்ந்தெடுக்கவும்).\n"

#: WhatsNext.py:552
msgid "  •  Click the \"Load Family Tree\" button to begin"
msgstr "  •  தேர்ந்தெடுத்த மரபுவழி மரத்துடன் வேலையைத் தொடங்க"

#: WhatsNext.py:553
msgid ""
" working with the selected genealogical tree.\n"
"\n"
msgstr ""
" \"குடும்ப மரத்தை ஏற்றவும்\" பொத்தானைச் சொடுக்கவும்.\n"
"\n"

#: WhatsNext.py:556
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Gramps காப்புப்பிரதியையோ, வேறு மரபுவழிக் கருவியின் GEDCOM கோப்பையோ பயன்படுத்த, \"குடும்ப மரங்கள்\" பட்டியலில் \"இறக்கு...\" என்பதைத் தேர்ந்தெடுக்கவும்.\n"
"\n"

#: WhatsNext.py:562
msgid ""
"To use a backup from Gramps, or a GEDCOM file from another genealogical tool, first create and load a new, empty tree. Then choose \"Import...\" in the \"Family Trees\" menu.\n"
"\n"
msgstr ""
"Gramps காப்புப்பிரதியையோ, வேறு மரபுவழிக் கருவியின் GEDCOM கோப்பையோ பயன்படுத்த, முதலில் புதிய, வெற்று மரத்தை உருவாக்கி ஏற்றவும். பின்னர் \"குடும்ப மரங்கள்\" பட்டியலில் \"இறக்கு...\" என்பதைத் தேர்ந்தெடுக்கவும்.\n"
"\n"

#: WhatsNext.py:622
msgid "Use the \"Configure\" in the \"View\" menu to change the Gramplet options."
msgstr ""
"கிராம்ப்லெட் விருப்பங்களை மாற்ற \"காட்சி\" பட்டியலில் உள்ள \"உள்ளமைவு\" "
"என்பதைப் பயன்படுத்தவும்."

#: WhatsNext.py:680 WhatsNext.py:1297
msgid "Organize Tags"
msgstr "குறிச்சொற்களை ஒழுங்கமைக்கவும்"

#: WhatsNext.py:719
msgid "Complete"
msgstr "முழுமையானது"

#: WhatsNext.py:720
msgid "Tag listed People and Families as Completed"
msgstr ""
"பட்டியலிடப்பட்ட நபர்களையும் குடும்பங்களையும் நிறைவுற்றது எனக் குறியிடு"

#: WhatsNext.py:729
msgid "Ignore"
msgstr "புறக்கணி"

#: WhatsNext.py:730
msgid "Tag to Ignore People and Families"
msgstr "நபர்களையும் குடும்பங்களையும் புறக்கணிக்கக் குறியிடு"

#: WhatsNext.py:739
msgid "Prune"
msgstr "கத்தரி"

#: WhatsNext.py:741
msgid "Tag to Prune (exclude) listed People and Families from testing"
msgstr ""
"பட்டியலிடப்பட்ட நபர்களையும் குடும்பங்களையும் சோதனையிலிருந்து கத்தரிக்க "
"(விலக்க) குறியிடு"

#: WhatsNext.py:820
msgid "Search Quota "
msgstr "தேடல் ஒதுக்கீடு "

#: WhatsNext.py:824
msgid ""
"The least number of lines to show. The search stops once this many problems "
"are found"
msgstr ""
"காட்ட வேண்டிய குறைந்தபட்ச வரிகளின் எண்ணிக்கை. இத்தனை சிக்கல்கள் கிடைத்ததும் "
"தேடல் நிற்கும்"

#: WhatsNext.py:832
msgid "Depth per loop"
msgstr "ஒரு சுற்றுக்கான ஆழம்"

#: WhatsNext.py:836
msgid ""
"How many generations of descendants to check before going up one more "
"generation of ancestors"
msgstr ""
"மூதாதையரில் இன்னொரு தலைமுறை மேலே செல்லும் முன் சரிபார்க்க வேண்டிய "
"சந்ததியினர் தலைமுறைகள் எத்தனை"

#: WhatsNext.py:844
msgid "Pause search expansion"
msgstr "தேடல் விரிவாக்கத்தை இடைநிறுத்து"

#: WhatsNext.py:848
msgid ""
"How many extra rounds to wait after checking an ancestor before checking the"
" descendants of that ancestor"
msgstr ""
"ஒரு மூதாதையரைச் சரிபார்த்த பின், அவரது சந்ததியினரைச் சரிபார்க்கும் முன் "
"காத்திருக்க வேண்டிய கூடுதல் சுற்றுகள் எத்தனை"

#: WhatsNext.py:856
msgid "Complete tag"
msgstr "நிறைவு குறிச்சொல்"

#: WhatsNext.py:857
msgid "Finished. Hide the object, and keep searching through it"
